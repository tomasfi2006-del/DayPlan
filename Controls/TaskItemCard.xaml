<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Planner.Controls.TaskItemCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Planner.Models"
    mc:Ignorable="d">

    <Border
        Margin="0,0,0,1"
        Background="{ThemeResource AppCardBackgroundBrush}"
        BorderBrush="{ThemeResource AppItemBorderBrush}"
        BorderThickness="0,0,0,1"
        Padding="12,10">

        <Grid RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Main Row -->
            <Grid Grid.Row="0" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Checkbox Button -->
                <Button
                    Grid.Column="0"
                    Width="20"
                    Height="20"
                    Padding="0"
                    VerticalAlignment="Center"
                    CornerRadius="4"
                    Click="OnCheckClicked"
                    Background="{x:Bind GetCheckBackground(TaskItem.IsCompleted), Mode=OneWay}"
                    BorderBrush="{x:Bind GetCheckBorder(TaskItem.IsCompleted), Mode=OneWay}"
                    BorderThickness="1.5">
                    <FontIcon
                        Glyph="&#xE73E;"
                        FontSize="11"
                        FontWeight="Bold"
                        Foreground="White"
                        Visibility="{x:Bind TaskItem.IsCompleted, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                </Button>

                <!-- Title & Calendar Icon -->
                <StackPanel
                    Grid.Column="1"
                    Orientation="Horizontal"
                    Spacing="8"
                    VerticalAlignment="Center"
                    Tapped="OnRowTapped">

                    <!-- Calendar icon if calendar synced -->
                    <FontIcon
                        Glyph="&#xE787;"
                        FontSize="14"
                        Foreground="{ThemeResource AppPrimaryAccentBrush}"
                        Visibility="{x:Bind TaskItem.IsCalendarSynced, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />

                    <TextBlock
                        Text="{x:Bind TaskItem.Title, Mode=OneWay}"
                        FontSize="13"
                        FontWeight="Medium"
                        TextTrimming="CharacterEllipsis"
                        Foreground="{ThemeResource AppTextPrimaryBrush}"
                        Opacity="{x:Bind GetTitleOpacity(TaskItem.IsCompleted), Mode=OneWay}"
                        TextDecorations="{x:Bind TaskItem.IsCompleted, Mode=OneWay, Converter={StaticResource BoolToStrikeThroughConverter}}" />
                </StackPanel>

                <!-- Right Metadata Badges -->
                <StackPanel
                    Grid.Column="2"
                    Orientation="Horizontal"
                    Spacing="6"
                    VerticalAlignment="Center">

                    <!-- Due Time Badge -->
                    <Border
                        Background="{ThemeResource AppCanvasBackgroundBrush}"
                        BorderBrush="{ThemeResource AppCardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="6,2"
                        Visibility="{x:Bind TaskItem.HasDueTime, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <FontIcon Glyph="&#xE823;" FontSize="10" Foreground="{ThemeResource AppTextSecondaryBrush}" />
                            <TextBlock Text="{x:Bind TaskItem.DueTimeText, Mode=OneWay}" FontSize="11" FontWeight="Medium" Foreground="{ThemeResource AppTextSecondaryBrush}" />
                        </StackPanel>
                    </Border>

                    <!-- Duration Badge -->
                    <Border
                        Background="{ThemeResource AppCanvasBackgroundBrush}"
                        BorderBrush="{ThemeResource AppCardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="6,2"
                        Visibility="{x:Bind TaskItem.HasDuration, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="{x:Bind TaskItem.DurationText, Mode=OneWay}" FontSize="11" FontWeight="Medium" Foreground="{ThemeResource AppTextSecondaryBrush}" />
                    </Border>

                    <!-- Project Badge -->
                    <Border
                        Background="{ThemeResource AppCanvasBackgroundBrush}"
                        BorderBrush="{ThemeResource AppCardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="6,2"
                        Visibility="{x:Bind TaskItem.HasProject, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="{x:Bind TaskItem.ProjectName, Mode=OneWay}" FontSize="11" FontWeight="Medium" Foreground="{ThemeResource AppTextSecondaryBrush}" />
                    </Border>

                    <!-- Primary Tag Badge -->
                    <Border
                        Background="{ThemeResource AppCanvasBackgroundBrush}"
                        BorderBrush="{ThemeResource AppCardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="6,2"
                        Visibility="{x:Bind TaskItem.HasTag, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <Ellipse Width="6" Height="6" Fill="{x:Bind TaskItem.TagColorHex, Converter={StaticResource HexToBrushConverter}}" VerticalAlignment="Center" />
                            <TextBlock Text="{x:Bind TaskItem.PrimaryTag, Mode=OneWay}" FontSize="11" FontWeight="SemiBold" Foreground="{x:Bind TaskItem.TagColorHex, Converter={StaticResource HexToBrushConverter}}" />
                        </StackPanel>
                    </Border>

                    <!-- Delete button -->
                    <Button
                        Width="24"
                        Height="24"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="OnDeleteClicked"
                        ToolTipService.ToolTip="Delete task">
                        <FontIcon Glyph="&#xE74D;" FontSize="11" Foreground="{ThemeResource AppTextSecondaryBrush}" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Expanded Details Sub-Panel -->
            <StackPanel
                Grid.Row="1"
                Margin="32,4,0,4"
                Spacing="8"
                Visibility="{x:Bind TaskItem.IsExpanded, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">

                <!-- Notes Block -->
                <Border
                    Background="{ThemeResource AppCanvasBackgroundBrush}"
                    BorderBrush="{ThemeResource AppCardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="10,8"
                    Visibility="{x:Bind TaskItem.HasNotes, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock
                        Text="{x:Bind TaskItem.Notes, Mode=OneWay}"
                        FontSize="12"
                        TextWrapping="Wrap"
                        Foreground="{ThemeResource AppTextSecondaryBrush}" />
                </Border>

                <!-- Sub-checklist Items -->
                <ItemsControl ItemsSource="{x:Bind TaskItem.Subtasks, Mode=OneWay}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:PlannerSubTask">
                            <Grid Margin="0,3" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <CheckBox
                                    Grid.Column="0"
                                    IsChecked="{x:Bind IsCompleted, Mode=TwoWay}"
                                    MinWidth="20"
                                    MinHeight="20"
                                    VerticalAlignment="Center" />

                                <TextBlock
                                    Grid.Column="1"
                                    Text="{x:Bind Title, Mode=OneWay}"
                                    FontSize="12"
                                    VerticalAlignment="Center"
                                    Foreground="{ThemeResource AppTextPrimaryBrush}"
                                    TextDecorations="{x:Bind IsCompleted, Mode=OneWay, Converter={StaticResource BoolToStrikeThroughConverter}}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Sub-action bar -->
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                        <Button
                            Padding="6,3"
                            FontSize="11"
                            CornerRadius="4"
                            Click="OnAddSubTaskClicked"
                            Background="Transparent"
                            BorderThickness="1"
                            BorderBrush="{ThemeResource AppCardBorderBrush}">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <FontIcon Glyph="&#xE710;" FontSize="10" Foreground="{ThemeResource AppPrimaryAccentBrush}" />
                                <TextBlock Text="Add Item" FontSize="11" Foreground="{ThemeResource AppTextSecondaryBrush}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <TextBlock
                        Grid.Column="1"
                        Text="Updated recently"
                        FontSize="10"
                        Foreground="{ThemeResource AppTextSecondaryBrush}"
                        VerticalAlignment="Center" />
                </Grid>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
