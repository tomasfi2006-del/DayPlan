<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Planner.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Planner.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Planner.Models"
    Background="{ThemeResource AppCanvasBackgroundBrush}"
    Loaded="OnPageLoaded"
    mc:Ignorable="d">

    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="N" Modifiers="Control" Invoked="OnCtrlNInvoked" />
    </Page.KeyboardAccelerators>

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Navigation View / Left Sidebar (250px, Collapsible) -->
            <ColumnDefinition Width="{x:Bind ViewModel.IsSidebarExpanded, Mode=OneWay, Converter={StaticResource BoolToGridLengthConverter}}" />
            <!-- Main Content Area -->
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ================= LEFT NAVIGATION SIDEBAR ================= -->
        <Border
            Grid.Column="0"
            Background="{ThemeResource AppSidebarBackgroundBrush}"
            BorderBrush="{ThemeResource AppCardBorderBrush}"
            BorderThickness="0,0,1,0">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Sidebar Header with Hamburger & Sync -->
                <Grid Grid.Row="0" Padding="12,10,12,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button
                        Grid.Column="0"
                        Width="32"
                        Height="32"
                        Padding="0"
                        CornerRadius="4"
                        Background="Transparent"
                        BorderThickness="0"
                        Command="{x:Bind ViewModel.ToggleSidebarCommand}"
                        ToolTipService.ToolTip="Collapse sidebar">
                        <FontIcon Glyph="&#xE700;" FontSize="14" Foreground="{ThemeResource AppTextPrimaryBrush}" />
                    </Button>

                    <Button
                        Grid.Column="2"
                        Width="32"
                        Height="32"
                        Padding="0"
                        CornerRadius="4"
                        Background="Transparent"
                        BorderThickness="0"
                        Command="{x:Bind ViewModel.RefreshDataCommand}"
                        ToolTipService.ToolTip="Sync">
                        <FontIcon Glyph="&#xE72C;" FontSize="13" Foreground="{ThemeResource AppTextSecondaryBrush}" />
                    </Button>
                </Grid>

                <!-- Scrollable Navigation Items -->
                <ScrollViewer Grid.Row="1" Padding="10,0">
                    <StackPanel Spacing="16">

                        <!-- Group 1: Focus -->
                        <StackPanel Spacing="2">
                            <TextBlock
                                Text="FOCUS"
                                FontSize="10"
                                FontWeight="Bold"
                                Foreground="{ThemeResource AppTextSecondaryBrush}"
                                Margin="8,4,0,4" />

                            <!-- Inbox -->
                            <Button
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                Padding="8,6"
                                CornerRadius="6"
                                BorderThickness="0"
                                Background="{x:Bind GetNavBackground(ViewModel.SelectedNavCategory, 'Inbox'), Mode=OneWay}"
                                Click="OnNavInboxClicked">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Grid.Column="0" Glyph="&#xE715;" FontSize="14" Foreground="{ThemeResource AppPrimaryAccentBrush}" Margin="0,0,8,0" />
                                    <TextBlock Grid.Column="1" Text="Inbox" FontSize="13" FontWeight="Medium" Foreground="{x:Bind GetNavTextForeground(ViewModel.SelectedNavCategory, 'Inbox'), Mode=OneWay}" VerticalAlignment="Center" />
                                    <Border Grid.Column="2" Background="{ThemeResource AppSubtleBarBrush}" CornerRadius="10" Padding="6,1" Visibility="{x:Bind ViewModel.InboxBadgeCount, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <TextBlock Text="{x:Bind ViewModel.InboxBadgeCount, Mode=OneWay}" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource AppTextSecondaryBrush}" />
                                    </Border>
                                </Grid>
                            </Button>

                            <!-- Today (Active indicator) -->
                            <Button
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                Padding="8,6"
                                CornerRadius="6"
                                BorderThickness="0"
                                Background="{x:Bind GetNavBackground(ViewModel.SelectedNavCategory, 'Today'), Mode=OneWay}"
                                Click="OnNavTodayClicked">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <!-- WinUI 3 Active Pill Indicator -->
                                    <Border Width="3" Height="14" CornerRadius="2" Background="{ThemeResource AppPrimaryAccentBrush}" HorizontalAlignment="Left" Margin="-6,0,6,0" Visibility="{x:Bind ViewModel.IsTodayView, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                    <FontIcon Grid.Column="0" Glyph="&#xE735;" FontSize="14" Foreground="{ThemeResource AppPrimaryAccentBrush}" Margin="0,0,8,0" />
                                    <TextBlock Grid.Column="1" Text="Today" FontSize="13" FontWeight="SemiBold" Foreground="{x:Bind GetNavTextForeground(ViewModel.SelectedNavCategory, 'Today'), Mode=OneWay}" VerticalAlignment="Center" />
                                    <Ellipse Grid.Column="2" Width="6" Height="6" Fill="{ThemeResource AppPrimaryAccentBrush}" VerticalAlignment="Center" Margin="0,0,4,0" />
                                </Grid>
                            </Button>

                            <!-- Upcoming -->
                            <Button
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                Padding="8,6"
                                CornerRadius="6"
                                BorderThickness="0"
                                Background="{x:Bind GetNavBackground(ViewModel.SelectedNavCategory, 'Upcoming'), Mode=OneWay}"
                                Click="OnNavUpcomingClicked">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Grid.Column="0" Glyph="&#xE787;" FontSize="14" Foreground="#D13438" Margin="0,0,8,0" />
                                    <TextBlock Grid.Column="1" Text="Upcoming" FontSize="13" FontWeight="Medium" Foreground="{x:Bind GetNavTextForeground(ViewModel.SelectedNavCategory, 'Upcoming'), Mode=OneWay}" VerticalAlignment="Center" />
                                </Grid>
                            </Button>

                            <!-- Anytime -->
                            <Button
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                Padding="8,6"
                                CornerRadius="6"
                                BorderThickness="0"
                                Background="{x:Bind GetNavBackground(ViewModel.SelectedNavCategory, 'Anytime'), Mode=OneWay}"
                                Click="OnNavAnytimeClicked">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Grid.Column="0" Glyph="&#xE81E;" FontSize="14" Foreground="#0078D4" Margin="0,0,8,0" />
                                    <TextBlock Grid.Column="1" Text="Anytime" FontSize="13" FontWeight="Medium" Foreground="{x:Bind GetNavTextForeground(ViewModel.SelectedNavCategory, 'Anytime'), Mode=OneWay}" VerticalAlignment="Center" />
                                </Grid>
                            </Button>

                            <!-- Someday -->
                            <Button
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                Padding="8,6"
                                CornerRadius="6"
                                BorderThickness="0"
                                Background="{x:Bind GetNavBackground(ViewModel.SelectedNavCategory, 'Someday'), Mode=OneWay}"
                                Click="OnNavSomedayClicked">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Grid.Column="0" Glyph="&#xE7B8;" FontSize="14" Foreground="{ThemeResource AppTextSecondaryBrush}" Margin="0,0,8,0" />
                                    <TextBlock Grid.Column="1" Text="Someday" FontSize="13" FontWeight="Medium" Foreground="{x:Bind GetNavTextForeground(ViewModel.SelectedNavCategory, 'Someday'), Mode=OneWay}" VerticalAlignment="Center" />
                                </Grid>
                            </Button>

                            <!-- Logbook -->
                            <Button
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                Padding="8,6"
                                CornerRadius="6"
                                BorderThickness="0"
                                Background="{x:Bind GetNavBackground(ViewModel.SelectedNavCategory, 'Logbook'), Mode=OneWay}"
                                Click="OnNavLogbookClicked">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Grid.Column="0" Glyph="&#xE73E;" FontSize="14" Foreground="#107C41" Margin="0,0,8,0" />
                                    <TextBlock Grid.Column="1" Text="Logbook" FontSize="13" FontWeight="Medium" Foreground="{x:Bind GetNavTextForeground(ViewModel.SelectedNavCategory, 'Logbook'), Mode=OneWay}" VerticalAlignment="Center" />
                                </Grid>
                            </Button>
                        </StackPanel>

                        <!-- Group 2: Areas & Projects -->
                        <StackPanel Spacing="4">
                            <Grid Margin="8,4,4,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Grid.Column="0"
                                    Text="AREAS &amp; PROJECTS"
                                    FontSize="10"
                                    FontWeight="Bold"
                                    Foreground="{ThemeResource AppTextSecondaryBrush}" />
                                <Button
                                    Grid.Column="1"
                                    Width="20"
                                    Height="20"
                                    Padding="0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Command="{x:Bind ViewModel.OpenNewListDialogCommand}"
                                    ToolTipService.ToolTip="Add Project">
                                    <FontIcon Glyph="&#xE710;" FontSize="11" Foreground="{ThemeResource AppTextSecondaryBrush}" />
                                </Button>
                            </Grid>

                            <!-- Empty state when no projects created yet -->
                            <TextBlock
                                Text="No projects yet"
                                FontSize="11"
                                Foreground="{ThemeResource AppTextSecondaryBrush}"
                                Margin="10,4,0,4"
                                Visibility="{x:Bind ViewModel.HasNoProjects, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />

                            <!-- Work Area Header & List -->
                            <StackPanel Visibility="{x:Bind ViewModel.HasWorkProjects, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" Spacing="2">
                                <StackPanel Orientation="Horizontal" Spacing="6" Margin="8,4,0,2">
                                    <FontIcon Glyph="&#xED43;" FontSize="12" Foreground="{ThemeResource AppTextSecondaryBrush}" />
                                    <TextBlock Text="Work" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource AppTextPrimaryBrush}" />
                                </StackPanel>

                                <ItemsControl ItemsSource="{x:Bind ViewModel.WorkProjects, Mode=OneWay}" Margin="12,0,0,4">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:PlannerProject">
                                            <Button
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Stretch"
                                                Padding="6,4"
                                                CornerRadius="4"
                                                BorderThickness="0"
                                                Background="Transparent"
                                                Click="OnProjectItemClicked">
                                                <Grid ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Ellipse
                                                        Grid.Column="0"
                                                        Width="7"
                                                        Height="7"
                                                        Fill="{x:Bind ColorHex, Converter={StaticResource HexToBrushConverter}}"
                                                        VerticalAlignment="Center" />
                                                    <TextBlock
                                                        Grid.Column="1"
                                                        Text="{x:Bind Name}"
                                                        FontSize="12"
                                                        Foreground="{ThemeResource AppTextPrimaryBrush}"
                                                        TextTrimming="CharacterEllipsis"
                                                        VerticalAlignment="Center" />
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <!-- Personal Area Header & List -->
                            <StackPanel Visibility="{x:Bind ViewModel.HasPersonalProjects, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" Spacing="2">
                                <StackPanel Orientation="Horizontal" Spacing="6" Margin="8,6,0,2">
                                    <FontIcon Glyph="&#xED43;" FontSize="12" Foreground="{ThemeResource AppTextSecondaryBrush}" />
                                    <TextBlock Text="Personal" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource AppTextPrimaryBrush}" />
                                </StackPanel>

                                <ItemsControl ItemsSource="{x:Bind ViewModel.PersonalProjects, Mode=OneWay}" Margin="12,0,0,4">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:PlannerProject">
                                            <Button
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Stretch"
                                                Padding="6,4"
                                                CornerRadius="4"
                                                BorderThickness="0"
                                                Background="Transparent"
                                                Click="OnProjectItemClicked">
                                                <Grid ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Ellipse
                                                        Grid.Column="0"
                                                        Width="7"
                                                        Height="7"
                                                        Fill="{x:Bind ColorHex, Converter={StaticResource HexToBrushConverter}}"
                                                        VerticalAlignment="Center" />
                                                    <TextBlock
                                                        Grid.Column="1"
                                                        Text="{x:Bind Name}"
                                                        FontSize="12"
                                                        Foreground="{ThemeResource AppTextPrimaryBrush}"
                                                        TextTrimming="CharacterEllipsis"
                                                        VerticalAlignment="Center" />
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>

                <!-- Footer: + New List & Settings Gear -->
                <Border
                    Grid.Row="2"
                    BorderBrush="{ThemeResource AppCardBorderBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="10,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- + New List Button -->
                        <Button
                            Grid.Column="0"
                            HorizontalAlignment="Stretch"
                            Padding="8,6"
                            CornerRadius="4"
                            Background="Transparent"
                            BorderThickness="0"
                            Command="{x:Bind ViewModel.OpenNewListDialogCommand}"
                            ToolTipService.ToolTip="Create a new list">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE710;" FontSize="13" Foreground="{ThemeResource AppPrimaryAccentBrush}" />
                                <TextBlock Text="New List" FontSize="12" FontWeight="Medium" Foreground="{ThemeResource AppTextPrimaryBrush}" />
                            </StackPanel>
                        </Button>

                        <!-- Settings Gear Button -->
                        <Button
                            Grid.Column="1"
                            Width="32"
                            Height="32"
                            Padding="0"
                            CornerRadius="4"
                            Background="Transparent"
                            BorderThickness="0"
                            Command="{x:Bind ViewModel.OpenSettingsCommand}"
                            ToolTipService.ToolTip="Settings">
                            <FontIcon Glyph="&#xE713;" FontSize="14" Foreground="{ThemeResource AppTextSecondaryBrush}" />
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- ================= MAIN WORKSPACE AREA ================= -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <!-- CommandBar / Filter Strip -->
                <RowDefinition Height="48" />
                <!-- Dynamic Content Canvas -->
                <RowDefinition Height="*" />
                <!-- Bottom Status Bar -->
                <RowDefinition Height="28" />
            </Grid.RowDefinitions>

            <!-- Top CommandBar Toolbar -->
            <Border
                Grid.Row="0"
                Background="{ThemeResource AppCardBackgroundBrush}"
                BorderBrush="{ThemeResource AppCardBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="16,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Left Group: Re-expand Button & Segmented Controls -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button
                            Width="32"
                            Height="32"
                            Padding="0"
                            CornerRadius="4"
                            Background="Transparent"
                            BorderThickness="0"
                            Command="{x:Bind ViewModel.ToggleSidebarCommand}"
                            ToolTipService.ToolTip="Show sidebar"
                            Visibility="{x:Bind ViewModel.IsSidebarExpanded, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=inverse}">
                            <FontIcon Glyph="&#xE700;" FontSize="14" Foreground="{ThemeResource AppTextPrimaryBrush}" />
                        </Button>

                        <!-- Segmented Capsule Pill Controls -->
                        <Border
                            Background="{ThemeResource AppCanvasBackgroundBrush}"
                            BorderBrush="{ThemeResource AppCardBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="3"
                            VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <Button Padding="10,3" FontSize="12" FontWeight="Medium" CornerRadius="6" BorderThickness="0" Background="{x:Bind GetSegmentBackground(ViewModel.SegmentFilter, 'All'), Mode=OneWay}" Foreground="{x:Bind GetSegmentForeground(ViewModel.SegmentFilter, 'All'), Mode=OneWay}" Click="OnFilterAllClicked" Content="All" />
                                <Button Padding="10,3" FontSize="12" FontWeight="Medium" CornerRadius="6" BorderThickness="0" Background="{x:Bind GetSegmentBackground(ViewModel.SegmentFilter, 'Work'), Mode=OneWay}" Foreground="{x:Bind GetSegmentForeground(ViewModel.SegmentFilter, 'Work'), Mode=OneWay}" Click="OnFilterWorkClicked" Content="Work" />
                                <Button Padding="10,3" FontSize="12" FontWeight="Medium" CornerRadius="6" BorderThickness="0" Background="{x:Bind GetSegmentBackground(ViewModel.SegmentFilter, 'Personal'), Mode=OneWay}" Foreground="{x:Bind GetSegmentForeground(ViewModel.SegmentFilter, 'Personal'), Mode=OneWay}" Click="OnFilterPersonalClicked" Content="Personal" />
                                <Button Padding="10,3" FontSize="12" FontWeight="Medium" CornerRadius="6" BorderThickness="0" Background="{x:Bind GetSegmentBackground(ViewModel.SegmentFilter, 'Focus'), Mode=OneWay}" Foreground="{x:Bind GetSegmentForeground(ViewModel.SegmentFilter, 'Focus'), Mode=OneWay}" Click="OnFilterFocusClicked" Content="Focus" />
                                <Button Padding="10,3" FontSize="12" FontWeight="Medium" CornerRadius="6" BorderThickness="0" Background="{x:Bind GetSegmentBackground(ViewModel.SegmentFilter, 'Quick 15m'), Mode=OneWay}" Foreground="{x:Bind GetSegmentForeground(ViewModel.SegmentFilter, 'Quick 15m'), Mode=OneWay}" Click="OnFilterQuickClicked" Content="Quick 15m" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Add Task Primary Button -->
                    <Button
                        Grid.Column="2"
                        Padding="14,6"
                        CornerRadius="6"
                        Background="{ThemeResource AppPrimaryAccentBrush}"
                        Foreground="White"
                        VerticalAlignment="Center"
                        Command="{x:Bind ViewModel.OpenCreateTaskDialogCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE710;" FontSize="12" FontWeight="Bold" Foreground="White" />
                            <TextBlock Text="Add Task" FontSize="12" FontWeight="SemiBold" Foreground="White" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- Scrollable Content Canvas -->
            <ScrollViewer Grid.Row="1" Padding="24,20">
                <Grid MaxWidth="1100" HorizontalAlignment="Stretch">

                    <!-- TODAY VIEW (Two-column layout like code.html) -->
                    <Grid Visibility="{x:Bind ViewModel.IsTodayView, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid.ColumnDefinitions>
                            <!-- 8 Cols: Tasks -->
                            <ColumnDefinition Width="*" />
                            <!-- 4 Cols: Horizon & Timeline (320px) -->
                            <ColumnDefinition Width="320" />
                        </Grid.ColumnDefinitions>

                        <!-- LEFT COLUMN: Primary Tasks Canvas -->
                        <StackPanel Grid.Column="0" Spacing="20" Margin="0,0,24,0">

                            <!-- Today Header & Progress Ring Stat Badge -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Title and Date -->
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12">
                                    <Border
                                        Width="40"
                                        Height="40"
                                        CornerRadius="20"
                                        Background="{ThemeResource AppPrimaryAccentSubtleBrush}"
                                        VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE735;" FontSize="20" Foreground="{ThemeResource AppPrimaryAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Today" FontSize="26" FontWeight="Bold" Foreground="{ThemeResource AppTextPrimaryBrush}" />
                                        <TextBlock Text="{x:Bind ViewModel.CurrentDateText, Mode=OneWay}" FontSize="13" Foreground="{ThemeResource AppTextSecondaryBrush}" />
                                    </StackPanel>
                                </StackPanel>

                                <!-- Fluent Progress Ring & Stat Badge -->
                                <Border
                                    Grid.Column="1"
                                    Background="{ThemeResource AppCardBackgroundBrush}"
                                    BorderBrush="{ThemeResource AppCardBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="12,8"
                                    VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <ProgressRing
                                            Width="22"
                                            Height="22"
                                            IsIndeterminate="False"
                                            Value="{x:Bind ViewModel.CompletionPercentage, Mode=OneWay}"
                                            Foreground="{ThemeResource AppPrimaryAccentBrush}" />
                                        <TextBlock
                                            Text="{x:Bind ViewModel.CompletionRatioText, Mode=OneWay}"
                                            FontSize="12"
                                            FontWeight="SemiBold"
                                            Foreground="{ThemeResource AppTextPrimaryBrush}"
                                            VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Tag Filter Chips (Dynamic & Theme-Aware) -->
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Button Padding="10,4" CornerRadius="4" FontSize="11" FontWeight="SemiBold" BorderThickness="0" Background="{x:Bind GetTagBackground(ViewModel.TagFilter, 'All'), Mode=OneWay}" Foreground="{x:Bind GetTagForeground(ViewModel.TagFilter, 'All'), Mode=OneWay}" Click="OnTagAllClicked" Content="All" />
                                    <ItemsControl ItemsSource="{x:Bind ViewModel.AvailableTags, Mode=OneWay}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" Spacing="6" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="models:PlannerTag">
                                                <Button
                                                    Padding="10,4"
                                                    CornerRadius="4"
                                                    FontSize="11"
                                                    FontWeight="Medium"
                                                    BorderThickness="1"
                                                    BorderBrush="{ThemeResource AppCardBorderBrush}"
                                                    Background="{ThemeResource AppCardBackgroundBrush}"
                                                    Click="OnTagChipClicked">
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <Ellipse Width="6" Height="6" Fill="{x:Bind ColorHex, Converter={StaticResource HexToBrushConverter}}" VerticalAlignment="Center" />
                                                        <TextBlock Text="{x:Bind Name}" Foreground="{ThemeResource AppTextPrimaryBrush}" FontSize="11" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>

                            <!-- Empty State for Today View -->
                            <Border
                                Background="{ThemeResource AppCardBackgroundBrush}"
                                BorderBrush="{ThemeResource AppCardBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="32,28"
                                Visibility="{x:Bind ViewModel.TotalTasksCount, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=inverse}">
                                <StackPanel HorizontalAlignment="Center" Spacing="10">
                                    <FontIcon Glyph="&#xE735;" FontSize="32" Foreground="{ThemeResource AppPrimaryAccentBrush}" HorizontalAlignment="Center" />
                                    <TextBlock Text="No tasks scheduled for today" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource AppTextPrimaryBrush}" HorizontalAlignment="Center" />
                                    <TextBlock Text="Click '+ Add Task' or press Ctrl+N to plan your day." FontSize="12" Foreground="{ThemeResource AppTextSecondaryBrush}" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>

                            <!-- Section 1: Morning & Priority Focus -->
                            <StackPanel Spacing="6">
                                <Grid Margin="4,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="MORNING &amp; PRIORITY FOCUS" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource AppTextSecondaryBrush}" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind GetCountLabel(ViewModel.MorningTasks.Count), Mode=OneWay}" FontSize="11" Foreground="{ThemeResource AppTextSecondaryBrush}" />
                                </Grid>
                                <Border Background="{ThemeResource AppCardBackgroundBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}" BorderThickness="1" CornerRadius="8">
                                    <ItemsControl ItemsSource="{x:Bind ViewModel.MorningTasks, Mode=OneWay}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="models:PlannerTask">
                                                <controls:TaskItemCard
                                                    TaskItem="{x:Bind}"
                                                    TaskToggleRequested="OnTaskToggleRequested"
                                                    TaskDeleteRequested="OnTaskDeleteRequested"
                                                    SubTaskAddRequested="OnSubTaskAddRequested" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>
                            </StackPanel>

                            <!-- Section 2: This Afternoon -->
                            <StackPanel Spacing="6">
                                <Grid Margin="4,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="THIS AFTERNOON" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource AppTextSecondaryBrush}" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind GetCountLabel(ViewModel.AfternoonTasks.Count), Mode=OneWay}" FontSize="11" Foreground="{ThemeResource AppTextSecondaryBrush}" />
                                </Grid>
                                <Border Background="{ThemeResource AppCardBackgroundBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}" BorderThickness="1" CornerRadius="8">
                                    <ItemsControl ItemsSource="{x:Bind ViewModel.AfternoonTasks, Mode=OneWay}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="models:PlannerTask">
                                                <controls:TaskItemCard
                                                    TaskItem="{x:Bind}"
                                                    TaskToggleRequested="OnTaskToggleRequested"
                                                    TaskDeleteRequested="OnTaskDeleteRequested"
                                                    SubTaskAddRequested="OnSubTaskAddRequested" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>
                            </StackPanel>

                            <!-- Section 3: Evening & Wind Down -->
                            <StackPanel Spacing="6">
                                <Grid Margin="4,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="EVENING &amp; WIND DOWN" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource AppTextSecondaryBrush}" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind GetCountLabel(ViewModel.EveningTasks.Count), Mode=OneWay}" FontSize="11" Foreground="{ThemeResource AppTextSecondaryBrush}" />
                                </Grid>
                                <Border Background="{ThemeResource AppCardBackgroundBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}" BorderThickness="1" CornerRadius="8">
                                    <ItemsControl ItemsSource="{x:Bind ViewModel.EveningTasks, Mode=OneWay}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="models:PlannerTask">
                                                <controls:TaskItemCard
                                                    TaskItem="{x:Bind}"
                                                    TaskToggleRequested="OnTaskToggleRequested"
                                                    TaskDeleteRequested="OnTaskDeleteRequested"
                                                    SubTaskAddRequested="OnSubTaskAddRequested" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>
                            </StackPanel>

                        </StackPanel>

                        <!-- RIGHT COLUMN: Horizon & Timeline Panel -->
                        <StackPanel Grid.Column="1" Spacing="16">

                            <!-- Today's Horizon Card -->
                            <Border
                                Background="{ThemeResource AppCardBackgroundBrush}"
                                BorderBrush="{ThemeResource AppCardBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="16">
                                <StackPanel Spacing="12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Today's Horizon" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource AppTextPrimaryBrush}" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                            <FontIcon Glyph="&#xE72C;" FontSize="11" Foreground="{ThemeResource AppPrimaryAccentBrush}" />
                                            <TextBlock Text="Synced" FontSize="11" FontWeight="Medium" Foreground="{ThemeResource AppPrimaryAccentBrush}" />
                                        </StackPanel>
                                    </Grid>

                                    <!-- Events List with Colored Accent Strips -->
                                    <ItemsControl ItemsSource="{x:Bind ViewModel.HorizonEvents, Mode=OneWay}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="models:CalendarHorizonEvent">
                                                <Border
                                                    Margin="0,0,0,8"
                                                    Padding="10"
                                                    CornerRadius="6"
                                                    Background="{ThemeResource AppCanvasBackgroundBrush}"
                                                    BorderBrush="{ThemeResource AppCardBorderBrush}"
                                                    BorderThickness="1">
                                                    <Grid ColumnSpacing="10">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <!-- Vertical Accent Bar -->
                                                        <Border
                                                            Grid.Column="0"
                                                            Width="3"
                                                            Height="28"
                                                            CornerRadius="1.5"
                                                            Background="{x:Bind AccentColor, Converter={StaticResource HexToBrushConverter}}" />
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                            <TextBlock Text="{x:Bind Title}" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource AppTextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{x:Bind TimeRange}" FontSize="11" Foreground="{ThemeResource AppTextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- Weekly Load Sparkline / Bar Chart Card -->
                            <Border
                                Background="{ThemeResource AppCardBackgroundBrush}"
                                BorderBrush="{ThemeResource AppCardBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="16">
                                <StackPanel Spacing="10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Weekly Load" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource AppTextPrimaryBrush}" />
                                        <TextBlock Grid.Column="1" Text="32 Tasks Total" FontSize="11" Foreground="{ThemeResource AppTextSecondaryBrush}" />
                                    </Grid>

                                    <!-- Native Weekly Load Chart with Viewbox + Canvas and Scrubber -->
                                    <controls:WeeklyLoadChart Height="90" HorizontalAlignment="Stretch" />
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </Grid>

                    <!-- GENERIC OTHER VIEWS (Inbox, Upcoming, Anytime, Someday, Logbook, Project) -->
                    <StackPanel
                        Spacing="20"
                        Visibility="{x:Bind ViewModel.IsTodayView, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=inverse}">

                        <!-- View Header -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="4">
                                <TextBlock Text="{x:Bind ViewModel.HeaderTitle, Mode=OneWay}" FontSize="24" FontWeight="Bold" Foreground="{ThemeResource AppTextPrimaryBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.HeaderSubtitle, Mode=OneWay}" FontSize="13" Foreground="{ThemeResource AppTextSecondaryBrush}" />
                            </StackPanel>
                        </Grid>

                        <!-- Empty State for Sectioned List -->
                        <Border
                            Background="{ThemeResource AppCardBackgroundBrush}"
                            BorderBrush="{ThemeResource AppCardBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="32,28"
                            Visibility="{x:Bind ViewModel.SectionedTasks.Count, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=inverse}">
                            <StackPanel HorizontalAlignment="Center" Spacing="10">
                                <FontIcon Glyph="&#xE715;" FontSize="32" Foreground="{ThemeResource AppPrimaryAccentBrush}" HorizontalAlignment="Center" />
                                <TextBlock Text="No tasks here yet" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource AppTextPrimaryBrush}" HorizontalAlignment="Center" />
                                <TextBlock Text="Click '+ Add Task' above or press Ctrl+N to create a task." FontSize="12" Foreground="{ThemeResource AppTextSecondaryBrush}" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <!-- Items List -->
                        <Border
                            Background="{ThemeResource AppCardBackgroundBrush}"
                            BorderBrush="{ThemeResource AppCardBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Visibility="{x:Bind ViewModel.SectionedTasks.Count, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                            <ItemsControl ItemsSource="{x:Bind ViewModel.SectionedTasks, Mode=OneWay}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:PlannerTask">
                                        <controls:TaskItemCard
                                            TaskItem="{x:Bind}"
                                            TaskToggleRequested="OnTaskToggleRequested"
                                            TaskDeleteRequested="OnTaskDeleteRequested"
                                            SubTaskAddRequested="OnSubTaskAddRequested" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                    </StackPanel>

                </Grid>
            </ScrollViewer>

            <!-- Bottom Status Bar -->
            <Border
                Grid.Row="2"
                Background="{ThemeResource AppCanvasBackgroundBrush}"
                BorderBrush="{ThemeResource AppCardBorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="16,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="4"
                            Tapped="OnCtrlNBadgeTapped"
                            ToolTipService.ToolTip="Click to focus New Task (Ctrl+N)">
                            <Border Background="{ThemeResource AppCardBackgroundBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}" BorderThickness="1" CornerRadius="3" Padding="4,1">
                                <TextBlock Text="Ctrl+N" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource AppTextPrimaryBrush}" />
                            </Border>
                            <TextBlock Text="New Task" FontSize="11" Foreground="{ThemeResource AppTextSecondaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <Border Background="{ThemeResource AppCardBackgroundBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}" BorderThickness="1" CornerRadius="3" Padding="4,1">
                                <TextBlock Text="Ctrl+Shift+N" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource AppTextPrimaryBrush}" />
                            </Border>
                            <TextBlock Text="New Section" FontSize="11" Foreground="{ThemeResource AppTextSecondaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <Border Background="{ThemeResource AppCardBackgroundBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}" BorderThickness="1" CornerRadius="3" Padding="4,1">
                                <TextBlock Text="Space" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource AppTextPrimaryBrush}" />
                            </Border>
                            <TextBlock Text="Complete" FontSize="11" Foreground="{ThemeResource AppTextSecondaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Cloud Sync Active Indicator -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <Ellipse Width="6" Height="6" Fill="#107C41" VerticalAlignment="Center" />
                        <TextBlock Text="Cloud Sync Active" FontSize="11" Foreground="{ThemeResource AppTextSecondaryBrush}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ================= MODAL DIALOGS ================= -->

        <!-- New List Dialog -->
        <ContentDialog
            x:Name="NewListModalDialog"
            Title="Create New List"
            PrimaryButtonText="Create"
            CloseButtonText="Cancel"
            DefaultButton="Primary"
            PrimaryButtonClick="OnCreateListConfirmed">
            <StackPanel Spacing="12" Margin="0,12,0,0">
                <TextBox
                    x:Name="NewListInput"
                    Header="List Name"
                    PlaceholderText="e.g. Mobile App Redesign"
                    Text="{x:Bind ViewModel.NewListName, Mode=TwoWay}" />
                <ComboBox
                    x:Name="AreaSelectComboBox"
                    Header="Area"
                    SelectedIndex="0"
                    HorizontalAlignment="Stretch">
                    <ComboBoxItem Content="Work" />
                    <ComboBoxItem Content="Personal" />
                </ComboBox>
            </StackPanel>
        </ContentDialog>

        <!-- Settings Dialog -->
        <ContentDialog
            x:Name="SettingsModalDialog"
            Title="Planner Settings"
            CloseButtonText="Close">
            <StackPanel Spacing="16" Margin="0,12,0,0" MinWidth="320">
                <StackPanel Spacing="6">
                    <TextBlock Text="App Theme" FontWeight="SemiBold" FontSize="13" Foreground="{ThemeResource AppTextPrimaryBrush}" />
                    <ComboBox
                        x:Name="ThemeComboBox"
                        SelectedIndex="{x:Bind ViewModel.SelectedThemeIndex, Mode=TwoWay}"
                        SelectionChanged="OnThemeSelectionChanged"
                        HorizontalAlignment="Stretch">
                        <ComboBoxItem Content="Light" />
                        <ComboBoxItem Content="Dark" />
                        <ComboBoxItem Content="Windows Default" />
                    </ComboBox>
                </StackPanel>

                <StackPanel Spacing="6">
                    <TextBlock Text="Sync &amp; Storage" FontWeight="SemiBold" FontSize="13" Foreground="{ThemeResource AppTextPrimaryBrush}" />
                    <TextBlock Text="Local cache-first storage with atomic write protection." FontSize="12" Foreground="{ThemeResource AppTextSecondaryBrush}" TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Spacing="4">
                    <TextBlock Text="About" FontWeight="SemiBold" FontSize="13" Foreground="{ThemeResource AppTextPrimaryBrush}" />
                    <TextBlock Text="Planner WinUI 3 v1.0.0 (Fluent Refined)" FontSize="12" Foreground="{ThemeResource AppTextSecondaryBrush}" />
                </StackPanel>
            </StackPanel>
        </ContentDialog>

        <!-- Create Task Modal Dialog -->
        <ContentDialog
            x:Name="CreateTaskModalDialog"
            Title="New Task"
            PrimaryButtonText="Add Task"
            CloseButtonText="Cancel"
            DefaultButton="Primary"
            PrimaryButtonClick="OnCreateTaskConfirmed">
            <StackPanel Spacing="12" Margin="0,10,0,0" MinWidth="380">
                <!-- Task Title -->
                <TextBox
                    x:Name="ModalTaskTitleBox"
                    Header="Title"
                    PlaceholderText="What do you need to do?"
                    Text="{x:Bind ViewModel.TaskDraftTitle, Mode=TwoWay}"
                    FontSize="13" />

                <!-- Section & Date row -->
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <ComboBox
                        Grid.Column="0"
                        Header="Section"
                        HorizontalAlignment="Stretch"
                        SelectedIndex="0"
                        SelectionChanged="OnModalSectionChanged">
                        <ComboBoxItem Content="Morning" />
                        <ComboBoxItem Content="Afternoon" />
                        <ComboBoxItem Content="Evening" />
                        <ComboBoxItem Content="Inbox" />
                    </ComboBox>

                    <CalendarDatePicker
                        Grid.Column="1"
                        Header="Due Date"
                        HorizontalAlignment="Stretch"
                        Date="{x:Bind ViewModel.TaskDraftDueDate, Mode=TwoWay}"
                        PlaceholderText="Pick date" />
                </Grid>

                <!-- Quick Presets -->
                <StackPanel Spacing="4">
                    <TextBlock Text="Schedule Preset" FontSize="11" Foreground="{ThemeResource AppTextSecondaryBrush}" />
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Button Padding="8,3" FontSize="11" CornerRadius="4" Content="Today" Click="OnSchedulePresetTodayClicked" />
                        <Button Padding="8,3" FontSize="11" CornerRadius="4" Content="Tomorrow" Click="OnSchedulePresetTomorrowClicked" />
                        <Button Padding="8,3" FontSize="11" CornerRadius="4" Content="9:00 AM" Click="OnSchedulePresetMorningClicked" />
                        <Button Padding="8,3" FontSize="11" CornerRadius="4" Content="2:00 PM" Click="OnSchedulePresetAfternoonClicked" />
                    </StackPanel>
                </StackPanel>

                <!-- Tag & Color Row -->
                <StackPanel Spacing="4">
                    <TextBlock Text="Tag &amp; Color" FontSize="11" Foreground="{ThemeResource AppTextSecondaryBrush}" />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox
                            Grid.Column="0"
                            PlaceholderText="e.g. #Work, #Personal, #Dev"
                            Text="{x:Bind ViewModel.TaskDraftTag, Mode=TwoWay}"
                            FontSize="12" />
                        <!-- Color Preview Circle -->
                        <Border
                            Grid.Column="1"
                            Width="26"
                            Height="26"
                            CornerRadius="13"
                            VerticalAlignment="Center"
                            BorderBrush="{ThemeResource AppCardBorderBrush}"
                            BorderThickness="1"
                            Background="{x:Bind ViewModel.TaskDraftTagColor, Mode=OneWay, Converter={StaticResource HexToBrushConverter}}" />
                    </Grid>

                    <!-- Curated Color Swatches -->
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                        <Button Width="20" Height="20" CornerRadius="10" Padding="0" Background="#005FB8" Click="OnColorSwatchClicked" Tag="#005FB8" ToolTipService.ToolTip="Blue" />
                        <Button Width="20" Height="20" CornerRadius="10" Padding="0" Background="#107C41" Click="OnColorSwatchClicked" Tag="#107C41" ToolTipService.ToolTip="Emerald" />
                        <Button Width="20" Height="20" CornerRadius="10" Padding="0" Background="#744DA9" Click="OnColorSwatchClicked" Tag="#744DA9" ToolTipService.ToolTip="Purple" />
                        <Button Width="20" Height="20" CornerRadius="10" Padding="0" Background="#CA5010" Click="OnColorSwatchClicked" Tag="#CA5010" ToolTipService.ToolTip="Amber" />
                        <Button Width="20" Height="20" CornerRadius="10" Padding="0" Background="#D13438" Click="OnColorSwatchClicked" Tag="#D13438" ToolTipService.ToolTip="Crimson" />
                        <Button Width="20" Height="20" CornerRadius="10" Padding="0" Background="#0078D4" Click="OnColorSwatchClicked" Tag="#0078D4" ToolTipService.ToolTip="Cyan" />
                        <Button Width="20" Height="20" CornerRadius="10" Padding="0" Background="#038387" Click="OnColorSwatchClicked" Tag="#038387" ToolTipService.ToolTip="Teal" />
                        <Button Width="20" Height="20" CornerRadius="10" Padding="0" Background="#475569" Click="OnColorSwatchClicked" Tag="#475569" ToolTipService.ToolTip="Slate" />
                    </StackPanel>
                </StackPanel>

                <!-- Notes Field -->
                <TextBox
                    Header="Notes (Optional)"
                    PlaceholderText="Add checklist notes or extra details..."
                    AcceptsReturn="True"
                    Height="60"
                    Text="{x:Bind ViewModel.TaskDraftNotes, Mode=TwoWay}"
                    FontSize="12" />
            </StackPanel>
        </ContentDialog>
    </Grid>
</Page>
