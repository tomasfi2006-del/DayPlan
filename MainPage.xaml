<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Planner.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Planner.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Planner.Models"
    Background="{ThemeResource AppCanvasBackgroundBrush}"
    Loaded="OnPageLoaded"
    mc:Ignorable="d">

    <Page.Resources>
        <Style x:Key="SidebarNavButtonStyle" TargetType="Button">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="RootGrid" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="HoverOverlay.Opacity" Value="1" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="HoverOverlay.Opacity" Value="0.6" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters>
                                            <Setter Target="RootGrid.Opacity" Value="0.5" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <Border x:Name="HoverOverlay" Background="{ThemeResource AppSubtleHoverBrush}" CornerRadius="{TemplateBinding CornerRadius}" Opacity="0" />
                            <ContentPresenter x:Name="ContentPresenter"
                                Padding="{TemplateBinding Padding}"
                                HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tag Filter Button Style with permanent drop shadow & rich darken hover (NEVER washes out white) -->
        <Style x:Key="TagFilterButtonStyle" TargetType="Button">
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="9,3" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="RootGrid" Margin="0,1,0,3">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="HoverDarkenOverlay.Opacity" Value="0.22" />
                                            <Setter Target="TagShadow.Opacity" Value="1" />
                                            <Setter Target="TagShadow.Margin" Value="0,3,0,-2.5" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="HoverDarkenOverlay.Opacity" Value="0.38" />
                                            <Setter Target="TagShadow.Opacity" Value="0.35" />
                                            <Setter Target="TagShadow.Margin" Value="0,1,0,0" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters>
                                            <Setter Target="PillSurface.Opacity" Value="0.5" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>

                            <!-- Drop Shadow Underlay -->
                            <Border
                                x:Name="TagShadow"
                                Margin="0,2,0,-1.5"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                Background="{ThemeResource AppTagShadowBrush}"
                                Opacity="0.75" />

                            <!-- Main Pill Surface -->
                            <Border
                                x:Name="PillSurface"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{TemplateBinding CornerRadius}">
                                <Grid>
                                    <!-- Inset border highlight for depth -->
                                    <Border
                                        CornerRadius="{TemplateBinding CornerRadius}"
                                        BorderBrush="#25FFFFFF"
                                        BorderThickness="1" />

                                    <!-- Hover Lighten Overlay (White tint works on any vivid tag colour in both themes) -->
                                    <Border
                                        x:Name="HoverDarkenOverlay"
                                        Background="White"
                                        CornerRadius="{TemplateBinding CornerRadius}"
                                        Opacity="0" />

                                    <!-- Crisp White Foreground -->
                                    <ContentPresenter
                                        x:Name="ContentPresenter"
                                        Content="{TemplateBinding Content}"
                                        ContentTemplate="{TemplateBinding ContentTemplate}"
                                        Padding="{TemplateBinding Padding}"
                                        HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                        VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                        Foreground="White"
                                        FontSize="{TemplateBinding FontSize}"
                                        FontWeight="{TemplateBinding FontWeight}" />
                                </Grid>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- All Filter Button Style with drop shadow & safe hover (preserves selection & text contrast) -->
        <Style x:Key="AllFilterButtonStyle" TargetType="Button">
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="12,3" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="RootGrid" Margin="0,1,0,3">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="HoverOverlay.Opacity" Value="1" />
                                            <Setter Target="AllShadow.Opacity" Value="0.95" />
                                            <Setter Target="AllShadow.Margin" Value="0,3,0,-2.5" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="HoverOverlay.Opacity" Value="0.6" />
                                            <Setter Target="AllShadow.Opacity" Value="0.35" />
                                            <Setter Target="AllShadow.Margin" Value="0,1,0,0" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters>
                                            <Setter Target="PillSurface.Opacity" Value="0.5" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>

                            <!-- Drop Shadow Underlay -->
                            <Border
                                x:Name="AllShadow"
                                Margin="0,2,0,-1.5"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                Background="{ThemeResource AppCardShadowBrush}"
                                Opacity="0.65" />

                            <!-- Main Pill Surface -->
                            <Border
                                x:Name="PillSurface"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{TemplateBinding CornerRadius}">
                                <Grid>
                                    <Border
                                        CornerRadius="{TemplateBinding CornerRadius}"
                                        BorderBrush="{ThemeResource AppCardBorderBrush}"
                                        BorderThickness="1" />

                                    <Border
                                        x:Name="HoverOverlay"
                                        Background="{ThemeResource AppSubtleHoverBrush}"
                                        CornerRadius="{TemplateBinding CornerRadius}"
                                        Opacity="0" />

                                    <ContentPresenter
                                        x:Name="ContentPresenter"
                                        Content="{TemplateBinding Content}"
                                        ContentTemplate="{TemplateBinding ContentTemplate}"
                                        Padding="{TemplateBinding Padding}"
                                        HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                        VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                        Foreground="{TemplateBinding Foreground}"
                                        FontSize="{TemplateBinding FontSize}"
                                        FontWeight="{TemplateBinding FontWeight}" />
                                </Grid>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Add Filter Button Style -->
        <Style x:Key="AddFilterPillButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="RootGrid" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="HoverOverlay.Opacity" Value="1" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="HoverOverlay.Opacity" Value="0.6" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters>
                                            <Setter Target="RootGrid.Opacity" Value="0.5" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <Border x:Name="HoverOverlay" Background="{ThemeResource AppSubtleHoverBrush}" CornerRadius="{TemplateBinding CornerRadius}" Opacity="0" />
                            <ContentPresenter x:Name="ContentPresenter"
                                Padding="{TemplateBinding Padding}"
                                HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="N" Modifiers="Control" Invoked="OnCtrlNInvoked" />
        <KeyboardAccelerator Key="F" Modifiers="Control" Invoked="OnCtrlFInvoked" />
        <KeyboardAccelerator Key="T" Modifiers="Control" Invoked="OnCtrlTInvoked" />
        <KeyboardAccelerator Key="I" Modifiers="Control" Invoked="OnCtrlIInvoked" />
    </Page.KeyboardAccelerators>

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Navigation View / Left Sidebar (250px, Collapsible) -->
            <ColumnDefinition Width="{x:Bind ViewModel.IsSidebarExpanded, Mode=OneWay, Converter={StaticResource BoolToGridLengthConverter}}" />
            <!-- Main Content Area -->
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ================= LEFT NAVIGATION SIDEBAR ================= -->
        <Border
            Grid.Column="0"
            Background="{ThemeResource AppSidebarBackgroundBrush}"
            BorderBrush="{ThemeResource AppCardBorderBrush}"
            BorderThickness="0,0,1,0">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Sidebar Header with Hamburger & Sync -->
                <Grid Grid.Row="0" Padding="12,10,12,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button
                        Grid.Column="0"
                        Width="32"
                        Height="32"
                        Padding="0"
                        CornerRadius="4"
                        Background="Transparent"
                        BorderThickness="0"
                        Command="{x:Bind ViewModel.ToggleSidebarCommand}"
                        ToolTipService.ToolTip="Collapse sidebar">
                        <FontIcon Glyph="&#xE700;" FontSize="14" Foreground="{ThemeResource AppTextPrimaryBrush}" />
                    </Button>

                    <Button
                        Grid.Column="2"
                        Width="32"
                        Height="32"
                        Padding="0"
                        CornerRadius="4"
                        Background="Transparent"
                        BorderThickness="0"
                        Command="{x:Bind ViewModel.RefreshDataCommand}"
                        ToolTipService.ToolTip="Sync">
                        <FontIcon Glyph="&#xE72C;" FontSize="13" Foreground="{ThemeResource AppTextSecondaryBrush}" />
                    </Button>
                </Grid>

                <!-- Scrollable Navigation Items -->
                <ScrollViewer Grid.Row="1" Padding="10,0">
                    <StackPanel Spacing="16">

                        <!-- Group 1: Focus -->
                        <StackPanel Spacing="2">
                            <TextBlock
                                Text="FOCUS"
                                FontSize="10"
                                FontWeight="Bold"
                                Foreground="{ThemeResource AppTextSecondaryBrush}"
                                Margin="8,4,0,4" />

                            <!-- Inbox -->
                            <Button
                                Style="{StaticResource SidebarNavButtonStyle}"
                                Background="{x:Bind GetNavBackground(ViewModel.SelectedNavCategory, 'Inbox'), Mode=OneWay}"
                                Click="OnNavInboxClicked">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Grid.Column="0" Glyph="&#xE715;" FontSize="14" Foreground="{ThemeResource AppPrimaryAccentBrush}" Margin="0,0,8,0" />
                                    <TextBlock Grid.Column="1" Text="Inbox" FontSize="13" FontWeight="Medium" Foreground="{x:Bind GetNavTextForeground(ViewModel.SelectedNavCategory, 'Inbox'), Mode=OneWay}" VerticalAlignment="Center" />
                                    <Border Grid.Column="2" Background="{ThemeResource AppSubtleBarBrush}" CornerRadius="10" Padding="6,1" Visibility="{x:Bind ViewModel.InboxBadgeCount, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <TextBlock Text="{x:Bind ViewModel.InboxBadgeCount, Mode=OneWay}" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource AppTextSecondaryBrush}" />
                                    </Border>
                                </Grid>
                            </Button>

                            <!-- Today (Active indicator) -->
                            <Button
                                Style="{StaticResource SidebarNavButtonStyle}"
                                Background="{x:Bind GetNavBackground(ViewModel.SelectedNavCategory, 'Today'), Mode=OneWay}"
                                Click="OnNavTodayClicked">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <!-- WinUI 3 Active Pill Indicator -->
                                    <Border Width="3" Height="14" CornerRadius="2" Background="{ThemeResource AppPrimaryAccentBrush}" HorizontalAlignment="Left" Margin="-6,0,6,0" Visibility="{x:Bind ViewModel.IsTodayView, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                    <FontIcon Grid.Column="0" Glyph="&#xE735;" FontSize="14" Foreground="{ThemeResource AppPrimaryAccentBrush}" Margin="0,0,8,0" />
                                    <TextBlock Grid.Column="1" Text="Today" FontSize="13" FontWeight="SemiBold" Foreground="{x:Bind GetNavTextForeground(ViewModel.SelectedNavCategory, 'Today'), Mode=OneWay}" VerticalAlignment="Center" />
                                    <Ellipse Grid.Column="2" Width="6" Height="6" Fill="{ThemeResource AppPrimaryAccentBrush}" VerticalAlignment="Center" Margin="0,0,4,0" />
                                </Grid>
                            </Button>

                            <!-- Upcoming -->
                            <Button
                                Style="{StaticResource SidebarNavButtonStyle}"
                                Background="{x:Bind GetNavBackground(ViewModel.SelectedNavCategory, 'Upcoming'), Mode=OneWay}"
                                Click="OnNavUpcomingClicked">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Grid.Column="0" Glyph="&#xE787;" FontSize="14" Foreground="#D13438" Margin="0,0,8,0" />
                                    <TextBlock Grid.Column="1" Text="Upcoming" FontSize="13" FontWeight="Medium" Foreground="{x:Bind GetNavTextForeground(ViewModel.SelectedNavCategory, 'Upcoming'), Mode=OneWay}" VerticalAlignment="Center" />
                                </Grid>
                            </Button>

                            <!-- Anytime -->
                            <Button
                                Style="{StaticResource SidebarNavButtonStyle}"
                                Background="{x:Bind GetNavBackground(ViewModel.SelectedNavCategory, 'Anytime'), Mode=OneWay}"
                                Click="OnNavAnytimeClicked">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Grid.Column="0" Glyph="&#xE81E;" FontSize="14" Foreground="#0078D4" Margin="0,0,8,0" />
                                    <TextBlock Grid.Column="1" Text="Anytime" FontSize="13" FontWeight="Medium" Foreground="{x:Bind GetNavTextForeground(ViewModel.SelectedNavCategory, 'Anytime'), Mode=OneWay}" VerticalAlignment="Center" />
                                </Grid>
                            </Button>

                            <!-- Someday -->
                            <Button
                                Style="{StaticResource SidebarNavButtonStyle}"
                                Background="{x:Bind GetNavBackground(ViewModel.SelectedNavCategory, 'Someday'), Mode=OneWay}"
                                Click="OnNavSomedayClicked">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Grid.Column="0" Glyph="&#xE7B8;" FontSize="14" Foreground="{ThemeResource AppTextSecondaryBrush}" Margin="0,0,8,0" />
                                    <TextBlock Grid.Column="1" Text="Someday" FontSize="13" FontWeight="Medium" Foreground="{x:Bind GetNavTextForeground(ViewModel.SelectedNavCategory, 'Someday'), Mode=OneWay}" VerticalAlignment="Center" />
                                </Grid>
                            </Button>

                            <!-- Logbook -->
                            <Button
                                Style="{StaticResource SidebarNavButtonStyle}"
                                Background="{x:Bind GetNavBackground(ViewModel.SelectedNavCategory, 'Logbook'), Mode=OneWay}"
                                Click="OnNavLogbookClicked">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Grid.Column="0" Glyph="&#xE73E;" FontSize="14" Foreground="#107C41" Margin="0,0,8,0" />
                                    <TextBlock Grid.Column="1" Text="Logbook" FontSize="13" FontWeight="Medium" Foreground="{x:Bind GetNavTextForeground(ViewModel.SelectedNavCategory, 'Logbook'), Mode=OneWay}" VerticalAlignment="Center" />
                                </Grid>
                            </Button>
                        </StackPanel>

                        <!-- Group 2: Areas & Projects -->
                        <StackPanel Spacing="4">
                            <Grid Margin="8,4,4,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Grid.Column="0"
                                    Text="AREAS &amp; PROJECTS"
                                    FontSize="10"
                                    FontWeight="Bold"
                                    Foreground="{ThemeResource AppTextSecondaryBrush}"
                                    VerticalAlignment="Center" />
                                <!-- [+] Button to Create New Area -->
                                <Button
                                    Grid.Column="1"
                                    Width="22"
                                    Height="22"
                                    Padding="0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    ToolTipService.ToolTip="Create new Area">
                                    <Button.Flyout>
                                        <Flyout x:Name="NewAreaFlyout">
                                            <StackPanel Spacing="8" Width="200">
                                                <TextBlock Text="New Area" FontWeight="SemiBold" FontSize="12" />
                                                <TextBlock Text="Presets:" FontSize="10" Foreground="{ThemeResource AppTextSecondaryBrush}" />
                                                <StackPanel Spacing="4">
                                                    <Button Content="Work" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="8,4" FontSize="11" Click="OnAreaPresetClicked" Tag="Work" />
                                                    <Button Content="Personal" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="8,4" FontSize="11" Click="OnAreaPresetClicked" Tag="Personal" />
                                                    <Button Content="Study" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="8,4" FontSize="11" Click="OnAreaPresetClicked" Tag="Study" />
                                                    <Button Content="Finance" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="8,4" FontSize="11" Click="OnAreaPresetClicked" Tag="Finance" />
                                                    <Button Content="Side Projects" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="8,4" FontSize="11" Click="OnAreaPresetClicked" Tag="Side Projects" />
                                                </StackPanel>
                                                <TextBlock Text="Or custom name:" FontSize="10" Foreground="{ThemeResource AppTextSecondaryBrush}" />
                                                <TextBox x:Name="CustomAreaNameBox" PlaceholderText="Area name..." FontSize="12" KeyDown="OnCustomAreaKeyDown" />
                                                <Button Content="Create Area" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch" Click="OnCreateCustomAreaClicked" />
                                            </StackPanel>
                                        </Flyout>
                                    </Button.Flyout>
                                    <FontIcon Glyph="&#xE710;" FontSize="11" Foreground="{ThemeResource AppTextSecondaryBrush}" />
                                </Button>
                            </Grid>

                            <!-- Dynamic Area Groups -->
                            <ItemsControl ItemsSource="{x:Bind ViewModel.AreaGroups, Mode=OneWay}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:ProjectAreaGroup">
                                        <StackPanel Spacing="2" Margin="0,2,0,8">
                                            <!-- Area Header Row with [+] to add a list in this area and [...] for options -->
                                            <Grid Margin="8,4,4,2">
                                                <Grid.ContextFlyout>
                                                    <MenuFlyout>
                                                        <MenuFlyoutItem Text="Delete Area" Tag="{x:Bind AreaName}" Click="OnDeleteAreaContextClicked">
                                                            <MenuFlyoutItem.Icon>
                                                                <FontIcon Glyph="&#xE74D;" Foreground="#E81123" />
                                                            </MenuFlyoutItem.Icon>
                                                        </MenuFlyoutItem>
                                                    </MenuFlyout>
                                                </Grid.ContextFlyout>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                    <FontIcon Glyph="&#xED43;" FontSize="11" Foreground="{ThemeResource AppTextSecondaryBrush}" />
                                                    <TextBlock Text="{x:Bind AreaName}" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource AppTextPrimaryBrush}" VerticalAlignment="Center" />
                                                </StackPanel>

                                                <!-- Actions: [+] Add List, [...] Options -->
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2">
                                                    <!-- [+] button to add a List inside this Area -->
                                                    <Button
                                                        Width="20"
                                                        Height="20"
                                                        Padding="0"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        ToolTipService.ToolTip="Add list to this Area">
                                                        <Button.Flyout>
                                                            <Flyout>
                                                                <StackPanel Spacing="8" Width="200" Tag="{x:Bind AreaName}" DataContext="{x:Bind}">
                                                                    <TextBlock Text="New List" FontWeight="SemiBold" FontSize="12" />
                                                                    <TextBlock Text="Presets:" FontSize="10" Foreground="{ThemeResource AppTextSecondaryBrush}" />
                                                                    <StackPanel Spacing="4">
                                                                        <Button Content="Sprint" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="8,4" FontSize="11" Click="OnListPresetClicked" Tag="Sprint" />
                                                                        <Button Content="Roadmap" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="8,4" FontSize="11" Click="OnListPresetClicked" Tag="Roadmap" />
                                                                        <Button Content="Backlog" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="8,4" FontSize="11" Click="OnListPresetClicked" Tag="Backlog" />
                                                                        <Button Content="Ideas" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="8,4" FontSize="11" Click="OnListPresetClicked" Tag="Ideas" />
                                                                        <Button Content="Admin" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="8,4" FontSize="11" Click="OnListPresetClicked" Tag="Admin" />
                                                                    </StackPanel>
                                                                    <TextBlock Text="Or custom name:" FontSize="10" Foreground="{ThemeResource AppTextSecondaryBrush}" />
                                                                    <TextBox PlaceholderText="List name..." FontSize="12" KeyDown="OnCustomListKeyDown" />
                                                                    <Button Content="Create List" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch" Click="OnCreateCustomListClicked" />
                                                                </StackPanel>
                                                            </Flyout>
                                                        </Button.Flyout>
                                                        <FontIcon Glyph="&#xE710;" FontSize="10" Foreground="{ThemeResource AppTextSecondaryBrush}" />
                                                    </Button>

                                                    <!-- [...] button for Area Options (Delete Area) -->
                                                    <Button
                                                        Width="20"
                                                        Height="20"
                                                        Padding="0"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        ToolTipService.ToolTip="Area options">
                                                        <Button.Flyout>
                                                            <MenuFlyout>
                                                                <MenuFlyoutItem Text="Delete Area" Tag="{x:Bind AreaName}" Click="OnDeleteAreaContextClicked">
                                                                    <MenuFlyoutItem.Icon>
                                                                        <FontIcon Glyph="&#xE74D;" Foreground="#E81123" />
                                                                    </MenuFlyoutItem.Icon>
                                                                </MenuFlyoutItem>
                                                            </MenuFlyout>
                                                        </Button.Flyout>
                                                        <FontIcon Glyph="&#xE712;" FontSize="10" Foreground="{ThemeResource AppTextSecondaryBrush}" />
                                                    </Button>
                                                </StackPanel>
                                            </Grid>

                                            <!-- Projects / Lists in this Area -->
                                            <ItemsControl ItemsSource="{x:Bind Projects}" Margin="12,0,0,2">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="models:PlannerProject">
                                                        <Button
                                                            HorizontalAlignment="Stretch"
                                                            HorizontalContentAlignment="Stretch"
                                                            Padding="6,4"
                                                            CornerRadius="4"
                                                            BorderThickness="0"
                                                            Background="Transparent"
                                                            Click="OnProjectItemClicked">
                                                            <Button.ContextFlyout>
                                                                <MenuFlyout>
                                                                    <MenuFlyoutItem Text="Delete List" Click="OnDeleteProjectContextClicked">
                                                                        <MenuFlyoutItem.Icon>
                                                                            <FontIcon Glyph="&#xE74D;" />
                                                                        </MenuFlyoutItem.Icon>
                                                                    </MenuFlyoutItem>
                                                                </MenuFlyout>
                                                            </Button.ContextFlyout>
                                                            <Grid ColumnSpacing="8">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <Ellipse
                                                                    Grid.Column="0"
                                                                    Width="7"
                                                                    Height="7"
                                                                    Fill="{x:Bind ColorHex, Converter={StaticResource HexToBrushConverter}}"
                                                                    VerticalAlignment="Center" />
                                                                <TextBlock
                                                                    Grid.Column="1"
                                                                    Text="{x:Bind Name}"
                                                                    FontSize="12"
                                                                    Foreground="{ThemeResource AppTextPrimaryBrush}"
                                                                    TextTrimming="CharacterEllipsis"
                                                                    VerticalAlignment="Center" />
                                                            </Grid>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Empty Area Prompt -->
                            <TextBlock
                                Text="Non Existent"
                                FontSize="11"
                                Foreground="{ThemeResource AppTextSecondaryBrush}"
                                Margin="12,2,0,4"
                                Visibility="{x:Bind ViewModel.HasAreas, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=inverse}" />
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>

                <!-- Footer: Clean Settings Button -->
                <Border
                    Grid.Row="2"
                    BorderBrush="{ThemeResource AppCardBorderBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="12,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Grid.Column="0"
                            Text="Planner"
                            FontSize="11"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource AppTextSecondaryBrush}"
                            VerticalAlignment="Center"
                            Margin="4,0,0,0" />

                        <!-- Settings Gear Button -->
                        <Button
                            Grid.Column="1"
                            Width="32"
                            Height="32"
                            Padding="0"
                            CornerRadius="4"
                            Background="Transparent"
                            BorderThickness="0"
                            Command="{x:Bind ViewModel.OpenSettingsCommand}"
                            ToolTipService.ToolTip="Settings">
                            <FontIcon Glyph="&#xE713;" FontSize="14" Foreground="{ThemeResource AppTextSecondaryBrush}" />
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- ================= MAIN WORKSPACE AREA ================= -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <!-- CommandBar / Filter Strip -->
                <RowDefinition Height="56" />
                <!-- Dynamic Content Canvas -->
                <RowDefinition Height="*" />
                <!-- Bottom Status Bar -->
                <RowDefinition Height="28" />
            </Grid.RowDefinitions>

            <!-- Top CommandBar Toolbar -->
            <Border
                Grid.Row="0"
                Background="{ThemeResource AppCardBackgroundBrush}"
                BorderBrush="{ThemeResource AppCardBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="16,8,16,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Left Group: Re-expand Button & Segmented Controls -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button
                            Width="32"
                            Height="32"
                            Padding="0"
                            CornerRadius="4"
                            Background="Transparent"
                            BorderThickness="0"
                            Command="{x:Bind ViewModel.ToggleSidebarCommand}"
                            ToolTipService.ToolTip="Show sidebar"
                            Visibility="{x:Bind ViewModel.IsSidebarExpanded, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=inverse}">
                            <FontIcon Glyph="&#xE700;" FontSize="14" Foreground="{ThemeResource AppTextPrimaryBrush}" />
                        </Button>

                        <!-- Dynamic Tag Filter Capsule Controls with Drop Shadow -->
                        <Grid VerticalAlignment="Center">
                            <!-- Drop Shadow Underlay -->
                            <Border
                                Margin="0,1.5,0,-1"
                                CornerRadius="8"
                                Background="{ThemeResource AppCardShadowBrush}" />

                            <Border
                                Background="{ThemeResource AppCanvasBackgroundBrush}"
                                BorderBrush="{ThemeResource AppCardBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="3">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <!-- "All" Pill -->
                                    <Button
                                        Style="{StaticResource AllFilterButtonStyle}"
                                        Background="{x:Bind GetAllFilterBackground(ViewModel.TagFilter), Mode=OneWay}"
                                        Foreground="{x:Bind GetAllFilterForeground(ViewModel.TagFilter), Mode=OneWay}"
                                        Click="OnFilterAllClicked"
                                        Content="All" />

                                <!-- Dynamic Filter Tags -->
                                <ItemsControl ItemsSource="{x:Bind ViewModel.AvailableTags, Mode=OneWay}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="3" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:PlannerTag">
                                            <Button
                                                Style="{StaticResource TagFilterButtonStyle}"
                                                Background="{x:Bind ColorHex, Converter={StaticResource HexToBrushConverter}}"
                                                Click="OnFilterTagChipClicked"
                                                Content="{x:Bind Name}"
                                                ToolTipService.ToolTip="Click to filter. Right-click to recolor or remove.">
                                                <Button.ContextFlyout>
                                                    <MenuFlyout>
                                                        <MenuFlyoutSubItem Text="Change Color">
                                                            <MenuFlyoutSubItem.Icon>
                                                                <FontIcon Glyph="&#xE790;" />
                                                            </MenuFlyoutSubItem.Icon>
                                                            <MenuFlyoutItem Text="Blue" Click="OnFilterTagMenuColorClicked" Tag="#005FB8" />
                                                            <MenuFlyoutItem Text="Emerald" Click="OnFilterTagMenuColorClicked" Tag="#107C41" />
                                                            <MenuFlyoutItem Text="Purple" Click="OnFilterTagMenuColorClicked" Tag="#744DA9" />
                                                            <MenuFlyoutItem Text="Amber" Click="OnFilterTagMenuColorClicked" Tag="#CA5010" />
                                                            <MenuFlyoutItem Text="Crimson" Click="OnFilterTagMenuColorClicked" Tag="#D13438" />
                                                            <MenuFlyoutItem Text="Cyan" Click="OnFilterTagMenuColorClicked" Tag="#0078D4" />
                                                            <MenuFlyoutItem Text="Teal" Click="OnFilterTagMenuColorClicked" Tag="#038387" />
                                                            <MenuFlyoutItem Text="Slate" Click="OnFilterTagMenuColorClicked" Tag="#475569" />
                                                        </MenuFlyoutSubItem>
                                                        <MenuFlyoutSeparator />
                                                        <MenuFlyoutItem Text="Delete Filter" Click="OnDeleteFilterTagClicked" Tag="{x:Bind Name}">
                                                            <MenuFlyoutItem.Icon>
                                                                <FontIcon Glyph="&#xE74D;" Foreground="#E81123" />
                                                            </MenuFlyoutItem.Icon>
                                                        </MenuFlyoutItem>
                                                    </MenuFlyout>
                                                </Button.ContextFlyout>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- [+] Add Filter Tag Button with Flyout -->
                                <Button
                                    Style="{StaticResource AddFilterPillButtonStyle}"
                                    ToolTipService.ToolTip="Add Filter Tag">
                                    <Button.Flyout>
                                        <Flyout x:Name="NewFilterFlyout">
                                            <StackPanel Width="220" Spacing="8">
                                                <TextBlock Text="New Filter Tag" FontWeight="SemiBold" FontSize="12" Foreground="{ThemeResource AppTextPrimaryBrush}" />
                                                <TextBox x:Name="NewFilterTagNameBox" PlaceholderText="Tag name (e.g. #Urgent)..." FontSize="12" KeyDown="OnNewFilterTagKeyDown" />
                                                <TextBlock Text="Choose Color" FontSize="11" Foreground="{ThemeResource AppTextSecondaryBrush}" />
                                                <StackPanel Orientation="Horizontal" Spacing="5">
                                                    <Button Width="20" Height="20" CornerRadius="10" Padding="0" Background="#005FB8" Click="OnNewFilterColorPicked" Tag="#005FB8" ToolTipService.ToolTip="Blue" />
                                                    <Button Width="20" Height="20" CornerRadius="10" Padding="0" Background="#107C41" Click="OnNewFilterColorPicked" Tag="#107C41" ToolTipService.ToolTip="Emerald" />
                                                    <Button Width="20" Height="20" CornerRadius="10" Padding="0" Background="#744DA9" Click="OnNewFilterColorPicked" Tag="#744DA9" ToolTipService.ToolTip="Purple" />
                                                    <Button Width="20" Height="20" CornerRadius="10" Padding="0" Background="#CA5010" Click="OnNewFilterColorPicked" Tag="#CA5010" ToolTipService.ToolTip="Amber" />
                                                    <Button Width="20" Height="20" CornerRadius="10" Padding="0" Background="#D13438" Click="OnNewFilterColorPicked" Tag="#D13438" ToolTipService.ToolTip="Crimson" />
                                                    <Button Width="20" Height="20" CornerRadius="10" Padding="0" Background="#0078D4" Click="OnNewFilterColorPicked" Tag="#0078D4" ToolTipService.ToolTip="Cyan" />
                                                    <Button Width="20" Height="20" CornerRadius="10" Padding="0" Background="#038387" Click="OnNewFilterColorPicked" Tag="#038387" ToolTipService.ToolTip="Teal" />
                                                </StackPanel>
                                                <Button Content="Add Filter" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch" Click="OnCreateNewFilterTagClicked" />
                                            </StackPanel>
                                        </Flyout>
                                    </Button.Flyout>
                                    <FontIcon Glyph="&#xE710;" FontSize="10" Foreground="{ThemeResource AppTextSecondaryBrush}" />
                                </Button>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>

                    <!-- Center Search Box -->
                    <AutoSuggestBox
                        x:Name="GlobalSearchBox"
                        Grid.Column="1"
                        MaxWidth="280"
                        Margin="16,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        PlaceholderText="Search tasks (Ctrl+F)"
                        Text="{x:Bind ViewModel.SearchText, Mode=TwoWay}"
                        QueryIcon="Find" />

                    <!-- Add Task Primary Button -->
                    <Button
                        Grid.Column="2"
                        Padding="14,6"
                        CornerRadius="6"
                        Background="{ThemeResource AppPrimaryAccentBrush}"
                        Foreground="White"
                        VerticalAlignment="Center"
                        Command="{x:Bind ViewModel.OpenCreateTaskDialogCommand}">
                        <Button.Resources>
                            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#106EBE" />
                            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#004E98" />
                            <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="White" />
                            <SolidColorBrush x:Key="ButtonForegroundPressed" Color="White" />
                        </Button.Resources>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE710;" FontSize="12" FontWeight="Bold" Foreground="White" />
                            <TextBlock Text="Add Task" FontSize="12" FontWeight="SemiBold" Foreground="White" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- Scrollable Content Canvas -->
            <ScrollViewer Grid.Row="1" Padding="24,20">
                <Grid MaxWidth="1100" HorizontalAlignment="Stretch">

                    <!-- TODAY VIEW (Two-column layout like code.html) -->
                    <Grid Visibility="{x:Bind ViewModel.IsTodayView, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid.ColumnDefinitions>
                            <!-- 8 Cols: Tasks -->
                            <ColumnDefinition Width="*" />
                            <!-- 4 Cols: Horizon & Timeline (320px) -->
                            <ColumnDefinition Width="320" />
                        </Grid.ColumnDefinitions>

                        <!-- LEFT COLUMN: Primary Tasks Canvas -->
                        <StackPanel Grid.Column="0" Spacing="20" Margin="0,0,24,0">

                            <!-- Today Header & Progress Ring Stat Badge -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Title and Date -->
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12">
                                    <Border
                                        Width="40"
                                        Height="40"
                                        CornerRadius="20"
                                        Background="{ThemeResource AppPrimaryAccentSubtleBrush}"
                                        VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE735;" FontSize="20" Foreground="{ThemeResource AppPrimaryAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Today" FontSize="26" FontWeight="Bold" Foreground="{ThemeResource AppTextPrimaryBrush}" />
                                        <TextBlock Text="{x:Bind ViewModel.CurrentDateText, Mode=OneWay}" FontSize="13" Foreground="{ThemeResource AppTextSecondaryBrush}" />
                                    </StackPanel>
                                </StackPanel>

                                <!-- Fluent Progress Ring & Stat Badge -->
                                <Grid Grid.Column="1" VerticalAlignment="Center" Margin="0,1,0,2">
                                    <Border Margin="0,2,0,-1.5" CornerRadius="8" Background="{ThemeResource AppCardShadowBrush}" />
                                    <Border
                                        Background="{ThemeResource AppCardBackgroundBrush}"
                                        BorderBrush="{ThemeResource AppCardBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="12,8">
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <ProgressRing
                                                Width="22"
                                                Height="22"
                                                IsIndeterminate="False"
                                                Value="{x:Bind ViewModel.CompletionPercentage, Mode=OneWay}"
                                                Foreground="{ThemeResource AppPrimaryAccentBrush}" />
                                            <TextBlock
                                                Text="{x:Bind ViewModel.CompletionRatioText, Mode=OneWay}"
                                                FontSize="12"
                                                FontWeight="SemiBold"
                                                Foreground="{ThemeResource AppTextPrimaryBrush}"
                                                VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Grid>

                            <!-- Empty State for Today View -->
                            <Grid Margin="0,1,0,2" Visibility="{x:Bind ViewModel.TotalTasksCount, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=inverse}">
                                <Border Margin="0,2,0,-1.5" CornerRadius="8" Background="{ThemeResource AppCardShadowBrush}" />
                                <Border
                                    Background="{ThemeResource AppCardBackgroundBrush}"
                                    BorderBrush="{ThemeResource AppCardBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="32,28">
                                    <StackPanel HorizontalAlignment="Center" Spacing="10">
                                        <FontIcon Glyph="&#xE735;" FontSize="32" Foreground="{ThemeResource AppPrimaryAccentBrush}" HorizontalAlignment="Center" />
                                        <TextBlock Text="No tasks scheduled for today" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource AppTextPrimaryBrush}" HorizontalAlignment="Center" />
                                        <TextBlock Text="Click '+ Add Task' to plan your day." FontSize="12" Foreground="{ThemeResource AppTextSecondaryBrush}" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Section 1: Morning & Priority Focus -->
                            <StackPanel Spacing="6">
                                <Grid Margin="4,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="MORNING &amp; PRIORITY FOCUS" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource AppTextSecondaryBrush}" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind GetCountLabel(ViewModel.MorningTasks.Count), Mode=OneWay}" FontSize="11" Foreground="{ThemeResource AppTextSecondaryBrush}" />
                                </Grid>
                                <Grid Margin="0,1,0,3">
                                    <Border Margin="0,2,0,-1.5" CornerRadius="8" Background="{ThemeResource AppCardShadowBrush}" />
                                    <Border Background="{ThemeResource AppCardBackgroundBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}" BorderThickness="1" CornerRadius="8">
                                        <ItemsControl ItemsSource="{x:Bind ViewModel.MorningTasks, Mode=OneWay}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="models:PlannerTask">
                                                    <controls:TaskItemCard
                                                        TaskItem="{x:Bind}"
                                                        TaskToggleRequested="OnTaskToggleRequested"
                                                        TaskDeleteRequested="OnTaskDeleteRequested"
                                                        TaskEditRequested="OnTaskEditRequested"
                                                        SubTaskAddRequested="OnSubTaskAddRequested"
                                                        SubTaskToggleRequested="OnSubTaskToggleRequested"
                                                        SubTaskDeleteRequested="OnSubTaskDeleteRequested"
                                                        SubTaskCreateRequested="OnSubTaskCreateRequested" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Border>
                                </Grid>
                            </StackPanel>

                            <!-- Section 2: This Afternoon -->
                            <StackPanel Spacing="6">
                                <Grid Margin="4,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="THIS AFTERNOON" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource AppTextSecondaryBrush}" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind GetCountLabel(ViewModel.AfternoonTasks.Count), Mode=OneWay}" FontSize="11" Foreground="{ThemeResource AppTextSecondaryBrush}" />
                                </Grid>
                                <Grid Margin="0,1,0,3">
                                    <Border Margin="0,2,0,-1.5" CornerRadius="8" Background="{ThemeResource AppCardShadowBrush}" />
                                    <Border Background="{ThemeResource AppCardBackgroundBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}" BorderThickness="1" CornerRadius="8">
                                        <ItemsControl ItemsSource="{x:Bind ViewModel.AfternoonTasks, Mode=OneWay}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="models:PlannerTask">
                                                    <controls:TaskItemCard
                                                        TaskItem="{x:Bind}"
                                                        TaskToggleRequested="OnTaskToggleRequested"
                                                        TaskDeleteRequested="OnTaskDeleteRequested"
                                                        TaskEditRequested="OnTaskEditRequested"
                                                        SubTaskAddRequested="OnSubTaskAddRequested"
                                                        SubTaskToggleRequested="OnSubTaskToggleRequested"
                                                        SubTaskDeleteRequested="OnSubTaskDeleteRequested"
                                                        SubTaskCreateRequested="OnSubTaskCreateRequested" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Border>
                                </Grid>
                            </StackPanel>

                            <!-- Section 3: Evening & Wind Down -->
                            <StackPanel Spacing="6">
                                <Grid Margin="4,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="EVENING &amp; WIND DOWN" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource AppTextSecondaryBrush}" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind GetCountLabel(ViewModel.EveningTasks.Count), Mode=OneWay}" FontSize="11" Foreground="{ThemeResource AppTextSecondaryBrush}" />
                                </Grid>
                                <Grid Margin="0,1,0,3">
                                    <Border Margin="0,2,0,-1.5" CornerRadius="8" Background="{ThemeResource AppCardShadowBrush}" />
                                    <Border Background="{ThemeResource AppCardBackgroundBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}" BorderThickness="1" CornerRadius="8">
                                        <ItemsControl ItemsSource="{x:Bind ViewModel.EveningTasks, Mode=OneWay}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="models:PlannerTask">
                                                    <controls:TaskItemCard
                                                        TaskItem="{x:Bind}"
                                                        TaskToggleRequested="OnTaskToggleRequested"
                                                        TaskDeleteRequested="OnTaskDeleteRequested"
                                                        TaskEditRequested="OnTaskEditRequested"
                                                        SubTaskAddRequested="OnSubTaskAddRequested"
                                                        SubTaskToggleRequested="OnSubTaskToggleRequested"
                                                        SubTaskDeleteRequested="OnSubTaskDeleteRequested"
                                                        SubTaskCreateRequested="OnSubTaskCreateRequested" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Border>
                                </Grid>
                            </StackPanel>

                        </StackPanel>

                        <!-- RIGHT COLUMN: Horizon & Timeline Panel -->
                        <StackPanel Grid.Column="1" Spacing="16">

                            <!-- Today's Horizon Card -->
                            <Grid Margin="0,1,0,3">
                                <Border Margin="0,2,0,-1.5" CornerRadius="8" Background="{ThemeResource AppCardShadowBrush}" />
                                <Border
                                    Background="{ThemeResource AppCardBackgroundBrush}"
                                    BorderBrush="{ThemeResource AppCardBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="16">
                                <StackPanel Spacing="12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Today's Horizon" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource AppTextPrimaryBrush}" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                            <FontIcon Glyph="&#xE72C;" FontSize="11" Foreground="{ThemeResource AppPrimaryAccentBrush}" />
                                            <TextBlock Text="Synced" FontSize="11" FontWeight="Medium" Foreground="{ThemeResource AppPrimaryAccentBrush}" />
                                        </StackPanel>
                                    </Grid>

                                    <!-- Events List with Colored Accent Strips -->
                                    <ItemsControl ItemsSource="{x:Bind ViewModel.HorizonEvents, Mode=OneWay}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="models:CalendarHorizonEvent">
                                                <Border
                                                    Margin="0,0,0,8"
                                                    Padding="10"
                                                    CornerRadius="6"
                                                    Background="{ThemeResource AppCanvasBackgroundBrush}"
                                                    BorderBrush="{ThemeResource AppCardBorderBrush}"
                                                    BorderThickness="1">
                                                    <Grid ColumnSpacing="10">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <!-- Vertical Accent Bar -->
                                                        <Border
                                                            Grid.Column="0"
                                                            Width="3"
                                                            Height="28"
                                                            CornerRadius="1.5"
                                                            Background="{x:Bind AccentColor, Converter={StaticResource HexToBrushConverter}}" />
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                            <TextBlock Text="{x:Bind Title}" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource AppTextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{x:Bind TimeRange}" FontSize="11" Foreground="{ThemeResource AppTextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Empty Horizon State -->
                                    <Border
                                        Padding="12,16"
                                        Background="{ThemeResource AppCanvasBackgroundBrush}"
                                        BorderBrush="{ThemeResource AppCardBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Visibility="{x:Bind ViewModel.HorizonEvents.Count, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=inverse}">
                                        <StackPanel HorizontalAlignment="Center" Spacing="4">
                                            <FontIcon Glyph="&#xE787;" FontSize="18" Foreground="{ThemeResource AppTextSecondaryBrush}" HorizontalAlignment="Center" />
                                            <TextBlock Text="No scheduled events today" FontSize="11" Foreground="{ThemeResource AppTextSecondaryBrush}" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Weekly Load Sparkline / Bar Chart Card -->
                        <Grid Margin="0,1,0,3">
                            <Border Margin="0,2,0,-1.5" CornerRadius="8" Background="{ThemeResource AppCardShadowBrush}" />
                            <Border
                                Background="{ThemeResource AppCardBackgroundBrush}"
                                BorderBrush="{ThemeResource AppCardBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="16">
                                <StackPanel Spacing="10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Weekly Load" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource AppTextPrimaryBrush}" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.WeeklyTotalTasksText, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource AppTextSecondaryBrush}" />
                                    </Grid>

                                    <!-- Native Weekly Load Chart with Viewbox + Canvas and Scrubber -->
                                    <controls:WeeklyLoadChart Height="90" HorizontalAlignment="Stretch" WeeklyLoads="{x:Bind ViewModel.WeeklyLoads, Mode=OneWay}" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        </StackPanel>
                    </Grid>

                    <!-- GENERIC OTHER VIEWS (Inbox, Upcoming, Anytime, Someday, Logbook, Project) -->
                    <StackPanel
                        Spacing="20"
                        Visibility="{x:Bind ViewModel.IsTodayView, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=inverse}">

                        <!-- View Header -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="4">
                                <TextBlock Text="{x:Bind ViewModel.HeaderTitle, Mode=OneWay}" FontSize="24" FontWeight="Bold" Foreground="{ThemeResource AppTextPrimaryBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.HeaderSubtitle, Mode=OneWay}" FontSize="13" Foreground="{ThemeResource AppTextSecondaryBrush}" />
                            </StackPanel>
                        </Grid>

                        <!-- Empty State for Sectioned List -->
                        <Grid Margin="0,1,0,3" Visibility="{x:Bind ViewModel.SectionedTasks.Count, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=inverse}">
                            <Border Margin="0,2,0,-1.5" CornerRadius="8" Background="{ThemeResource AppCardShadowBrush}" />
                            <Border
                                Background="{ThemeResource AppCardBackgroundBrush}"
                                BorderBrush="{ThemeResource AppCardBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="32,28">
                                <StackPanel HorizontalAlignment="Center" Spacing="10">
                                    <FontIcon Glyph="&#xE715;" FontSize="32" Foreground="{ThemeResource AppPrimaryAccentBrush}" HorizontalAlignment="Center" />
                                    <TextBlock Text="No tasks here yet" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource AppTextPrimaryBrush}" HorizontalAlignment="Center" />
                                    <TextBlock Text="Click '+ Add Task' above to create a task." FontSize="12" Foreground="{ThemeResource AppTextSecondaryBrush}" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Items List -->
                        <Grid Margin="0,1,0,3" Visibility="{x:Bind ViewModel.SectionedTasks.Count, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Border Margin="0,2,0,-1.5" CornerRadius="8" Background="{ThemeResource AppCardShadowBrush}" />
                            <Border
                                Background="{ThemeResource AppCardBackgroundBrush}"
                                BorderBrush="{ThemeResource AppCardBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8">
                                <ItemsControl ItemsSource="{x:Bind ViewModel.SectionedTasks, Mode=OneWay}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:PlannerTask">
                                            <controls:TaskItemCard
                                                TaskItem="{x:Bind}"
                                                TaskToggleRequested="OnTaskToggleRequested"
                                                TaskDeleteRequested="OnTaskDeleteRequested"
                                                TaskEditRequested="OnTaskEditRequested"
                                                SubTaskAddRequested="OnSubTaskAddRequested"
                                                SubTaskToggleRequested="OnSubTaskToggleRequested"
                                                SubTaskDeleteRequested="OnSubTaskDeleteRequested"
                                                SubTaskCreateRequested="OnSubTaskCreateRequested" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                        </Grid>
                    </StackPanel>

                </Grid>
            </ScrollViewer>

            <!-- Bottom Status Bar -->
            <Border
                Grid.Row="2"
                Background="{ThemeResource AppCanvasBackgroundBrush}"
                BorderBrush="{ThemeResource AppCardBorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="16,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                        <TextBlock Text="Planner Workspace" FontSize="11" Foreground="{ThemeResource AppTextSecondaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Cloud Sync Active Indicator -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <Ellipse Width="6" Height="6" Fill="#107C41" VerticalAlignment="Center" />
                        <TextBlock Text="Cloud Sync Active" FontSize="11" Foreground="{ThemeResource AppTextSecondaryBrush}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ================= MODAL DIALOGS ================= -->

        <!-- New List Dialog -->
        <ContentDialog
            x:Name="NewListModalDialog"
            Title="Create New List"
            PrimaryButtonText="Create"
            CloseButtonText="Cancel"
            DefaultButton="Primary"
            PrimaryButtonClick="OnCreateListConfirmed">
            <StackPanel Spacing="12" Margin="0,12,0,0">
                <TextBox
                    x:Name="NewListInput"
                    Header="List Name"
                    PlaceholderText="e.g. Mobile App Redesign"
                    Text="{x:Bind ViewModel.NewListName, Mode=TwoWay}" />
                <ComboBox
                    x:Name="AreaSelectComboBox"
                    Header="Area"
                    SelectedIndex="0"
                    HorizontalAlignment="Stretch">
                    <ComboBoxItem Content="Work" />
                    <ComboBoxItem Content="Personal" />
                </ComboBox>
            </StackPanel>
        </ContentDialog>

        <!-- Settings Dialog -->
        <ContentDialog
            x:Name="SettingsModalDialog"
            Title="Planner Settings"
            CloseButtonText="Close">
            <StackPanel Spacing="16" Margin="0,12,0,0" MinWidth="320">
                <StackPanel Spacing="6">
                    <TextBlock Text="App Theme" FontWeight="SemiBold" FontSize="13" Foreground="{ThemeResource AppTextPrimaryBrush}" />
                    <ComboBox
                        x:Name="ThemeComboBox"
                        SelectedIndex="{x:Bind ViewModel.SelectedThemeIndex, Mode=TwoWay}"
                        SelectionChanged="OnThemeSelectionChanged"
                        HorizontalAlignment="Stretch">
                        <ComboBoxItem Content="Light" />
                        <ComboBoxItem Content="Dark" />
                        <ComboBoxItem Content="Windows Default" />
                    </ComboBox>
                </StackPanel>

                <StackPanel Spacing="6">
                    <TextBlock Text="Data &amp; Storage Location" FontWeight="SemiBold" FontSize="13" Foreground="{ThemeResource AppTextPrimaryBrush}" />
                    <TextBlock Text="Folder where tasks and application settings are stored." FontSize="12" Foreground="{ThemeResource AppTextSecondaryBrush}" TextWrapping="Wrap" />
                    <Grid ColumnSpacing="8" Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox
                            Grid.Column="0"
                            IsReadOnly="True"
                            Text="{x:Bind ViewModel.CurrentStoragePath, Mode=OneWay}"
                            FontSize="11"
                            VerticalAlignment="Center" />
                        <Button
                            Grid.Column="1"
                            Content="Browse..."
                            Click="OnBrowseStorageFolderClicked"
                            VerticalAlignment="Center" />
                    </Grid>
                    <Button
                        Content="Reset to Default Location"
                        FontSize="11"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="{ThemeResource AppPrimaryAccentBrush}"
                        Click="OnResetStorageLocationClicked"
                        HorizontalAlignment="Left" />
                </StackPanel>

                <StackPanel Spacing="4">
                    <TextBlock Text="About" FontWeight="SemiBold" FontSize="13" Foreground="{ThemeResource AppTextPrimaryBrush}" />
                    <TextBlock Text="Planner WinUI 3 v1.0.0 (Fluent Refined)" FontSize="12" Foreground="{ThemeResource AppTextSecondaryBrush}" />
                </StackPanel>
            </StackPanel>
        </ContentDialog>

        <!-- Create Task Modal Dialog (Rectangular Widescreen) -->
        <ContentDialog
            x:Name="CreateTaskModalDialog"
            Title="New Task"
            PrimaryButtonText="Add Task"
            CloseButtonText="Cancel"
            DefaultButton="Primary"
            PrimaryButtonClick="OnCreateTaskConfirmed">
            <ContentDialog.Resources>
                <x:Double x:Key="ContentDialogMaxWidth">820</x:Double>
                <x:Double x:Key="ContentDialogMaxHeight">660</x:Double>
            </ContentDialog.Resources>
            <Grid Width="720" RowSpacing="12" Margin="0,6,0,0">
                <Grid.RowDefinitions>
                    <!-- Row 0: Full-width Header: Title & Tags -->
                    <RowDefinition Height="Auto" />
                    <!-- Row 1: Two Columns: Left (Settings) and Right (Description & Checklists) -->
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Full-Width Header: Title & Tag System -->
                <StackPanel Grid.Row="0" Spacing="8">
                    <!-- Title -->
                    <TextBox
                        x:Name="ModalTaskTitleBox"
                        Header="Title"
                        PlaceholderText="What do you need to do?"
                        Text="{x:Bind ViewModel.TaskDraftTitle, Mode=TwoWay}"
                        FontSize="14"
                        FontWeight="SemiBold" />

                    <!-- Tags Header & Quick Presets -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <TextBlock Text="Tags (#):" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource AppTextSecondaryBrush}" VerticalAlignment="Center" />
                            <Button Content="#Work" Padding="8,2" FontSize="11" CornerRadius="10" Click="OnQuickTagWorkClicked" Background="{ThemeResource AppCardBackgroundBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}" BorderThickness="1" Foreground="{ThemeResource AppTextPrimaryBrush}" />
                            <Button Content="#Personal" Padding="8,2" FontSize="11" CornerRadius="10" Click="OnQuickTagPersonalClicked" Background="{ThemeResource AppCardBackgroundBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}" BorderThickness="1" Foreground="{ThemeResource AppTextPrimaryBrush}" />
                            <Button Content="#Focus" Padding="8,2" FontSize="11" CornerRadius="10" Click="OnQuickTagFocusClicked" Background="{ThemeResource AppCardBackgroundBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}" BorderThickness="1" Foreground="{ThemeResource AppTextPrimaryBrush}" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="Right-click chip to change color" FontSize="10" Foreground="{ThemeResource AppTextSecondaryBrush}" VerticalAlignment="Center" />
                    </Grid>

                    <!-- Tag Input & Active Chips Row -->
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Add Tag Input Box -->
                        <Grid Grid.Column="0" ColumnSpacing="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox
                                x:Name="DraftTagInputBox"
                                Grid.Column="0"
                                PlaceholderText="Type #tag..."
                                Text="{x:Bind ViewModel.DraftTagInputText, Mode=TwoWay}"
                                FontSize="12"
                                KeyDown="OnDraftTagInputKeyDown" />
                            <Button Grid.Column="1" Content="Add" Click="OnAddDraftTagButtonClicked" FontSize="11" Padding="8,5" />
                        </Grid>

                        <!-- Active Tag Chips Scrollable -->
                        <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{x:Bind ViewModel.DraftTaskTags, Mode=OneWay}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="6" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:PlannerTag">
                                        <Grid Margin="0,1,0,2">
                                            <Border Margin="0,1.5,0,-1" CornerRadius="12" Background="{ThemeResource AppTagShadowBrush}" />
                                            <Border
                                                Background="{x:Bind ColorHex, Converter={StaticResource HexToBrushConverter}}"
                                                CornerRadius="12"
                                                Padding="8,3,4,3"
                                                ToolTipService.ToolTip="Right-click to change color">
                                                <Border.ContextFlyout>
                                                    <Flyout>
                                                        <StackPanel Spacing="6">
                                                            <TextBlock Text="Choose Tag Color" FontSize="11" FontWeight="SemiBold" />
                                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                                <Button Width="20" Height="20" CornerRadius="10" Padding="0" Background="#005FB8" Click="OnDraftTagChipColorClicked" Tag="#005FB8" ToolTipService.ToolTip="Blue" />
                                                                <Button Width="20" Height="20" CornerRadius="10" Padding="0" Background="#107C41" Click="OnDraftTagChipColorClicked" Tag="#107C41" ToolTipService.ToolTip="Emerald" />
                                                                <Button Width="20" Height="20" CornerRadius="10" Padding="0" Background="#744DA9" Click="OnDraftTagChipColorClicked" Tag="#744DA9" ToolTipService.ToolTip="Purple" />
                                                                <Button Width="20" Height="20" CornerRadius="10" Padding="0" Background="#CA5010" Click="OnDraftTagChipColorClicked" Tag="#CA5010" ToolTipService.ToolTip="Amber" />
                                                                <Button Width="20" Height="20" CornerRadius="10" Padding="0" Background="#D13438" Click="OnDraftTagChipColorClicked" Tag="#D13438" ToolTipService.ToolTip="Crimson" />
                                                                <Button Width="20" Height="20" CornerRadius="10" Padding="0" Background="#0078D4" Click="OnDraftTagChipColorClicked" Tag="#0078D4" ToolTipService.ToolTip="Cyan" />
                                                                <Button Width="20" Height="20" CornerRadius="10" Padding="0" Background="#038387" Click="OnDraftTagChipColorClicked" Tag="#038387" ToolTipService.ToolTip="Teal" />
                                                                <Button Width="20" Height="20" CornerRadius="10" Padding="0" Background="#475569" Click="OnDraftTagChipColorClicked" Tag="#475569" ToolTipService.ToolTip="Slate" />
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Flyout>
                                                </Border.ContextFlyout>
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <TextBlock Text="{x:Bind Name}" FontSize="11" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center" />
                                                    <Button Width="18" Height="18" Padding="0" Background="Transparent" BorderThickness="0" Click="OnRemoveDraftTagClicked" ToolTipService.ToolTip="Remove tag">
                                                        <FontIcon Glyph="&#xE711;" FontSize="9" Foreground="White" Opacity="0.8" />
                                                    </Button>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </StackPanel>

                <!-- Two-Column Body: Left Settings | Right Description & Checklist -->
                <Grid Grid.Row="1" ColumnSpacing="20">
                    <Grid.ColumnDefinitions>
                        <!-- Left: Settings (290px) -->
                        <ColumnDefinition Width="290" />
                        <!-- Right: Description & Checklists (Flex) -->
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- LEFT COLUMN: Settings -->
                    <StackPanel Grid.Column="0" Spacing="10">
                        <Grid Margin="0,1,0,3">
                            <Border Margin="0,2,0,-1.5" CornerRadius="8" Background="{ThemeResource AppCardShadowBrush}" />
                            <Border Background="{ThemeResource AppCardBackgroundBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="Settings" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource AppTextPrimaryBrush}" />

                                    <!-- Section -->
                                    <ComboBox
                                        Header="Section"
                                        HorizontalAlignment="Stretch"
                                        SelectedIndex="0"
                                        SelectionChanged="OnModalSectionChanged">
                                        <ComboBoxItem Content="Morning" />
                                        <ComboBoxItem Content="Afternoon" />
                                        <ComboBoxItem Content="Evening" />
                                        <ComboBoxItem Content="Inbox" />
                                    </ComboBox>

                                    <!-- Due Date -->
                                    <CalendarDatePicker
                                        Header="Due Date"
                                        HorizontalAlignment="Stretch"
                                        Date="{x:Bind ViewModel.TaskDraftDueDate, Mode=TwoWay}"
                                        PlaceholderText="Pick date" />

                                    <!-- Duration -->
                                    <ComboBox
                                        Header="Duration"
                                        HorizontalAlignment="Stretch"
                                        Text="{x:Bind ViewModel.TaskDraftDuration, Mode=TwoWay}"
                                        IsEditable="True"
                                        PlaceholderText="e.g. 15m, 30m">
                                        <ComboBoxItem Content="15m" />
                                        <ComboBoxItem Content="30m" />
                                        <ComboBoxItem Content="45m" />
                                        <ComboBoxItem Content="1h" />
                                        <ComboBoxItem Content="2h" />
                                    </ComboBox>

                                    <!-- Schedule Presets -->
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Schedule Presets" FontSize="11" Foreground="{ThemeResource AppTextSecondaryBrush}" />
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <Button Padding="6,2" FontSize="10" CornerRadius="4" Content="Today" Click="OnSchedulePresetTodayClicked" />
                                            <Button Padding="6,2" FontSize="10" CornerRadius="4" Content="Tomorrow" Click="OnSchedulePresetTomorrowClicked" />
                                            <Button Padding="6,2" FontSize="10" CornerRadius="4" Content="9:00 AM" Click="OnSchedulePresetMorningClicked" />
                                            <Button Padding="6,2" FontSize="10" CornerRadius="4" Content="2:00 PM" Click="OnSchedulePresetAfternoonClicked" />
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- List / Project (No "+ New", shows "Non Existent" if empty) -->
                                    <ComboBox
                                        Header="List / Project"
                                        HorizontalAlignment="Stretch"
                                        ItemsSource="{x:Bind ViewModel.Projects, Mode=OneWay}"
                                        DisplayMemberPath="Name"
                                        SelectedValuePath="Id"
                                        SelectedValue="{x:Bind ViewModel.TaskDraftProjectId, Mode=TwoWay}"
                                        PlaceholderText="{x:Bind ViewModel.ProjectPlaceholderText, Mode=OneWay}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>

                    <!-- RIGHT COLUMN: Description & Checklist -->
                    <StackPanel Grid.Column="1" Spacing="10">
                        <!-- Description / Notes -->
                        <TextBox
                            Header="Description"
                            PlaceholderText="Extra details or description..."
                            AcceptsReturn="True"
                            Height="90"
                            Text="{x:Bind ViewModel.TaskDraftNotes, Mode=TwoWay}"
                            FontSize="12" />

                        <!-- Checklist / Subtasks -->
                        <Grid Margin="0,1,0,3">
                            <Border Margin="0,2,0,-1.5" CornerRadius="8" Background="{ThemeResource AppCardShadowBrush}" />
                            <Border Background="{ThemeResource AppCardBackgroundBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="Checklists &amp; Subtasks" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource AppTextPrimaryBrush}" />

                                    <!-- Add Subtask Input -->
                                    <Grid ColumnSpacing="6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox
                                            x:Name="DraftSubtaskInputBox"
                                            Grid.Column="0"
                                            PlaceholderText="Add checklist item and press Enter..."
                                            Text="{x:Bind ViewModel.DraftSubtaskInputText, Mode=TwoWay}"
                                            FontSize="12"
                                            KeyDown="OnDraftSubtaskInputKeyDown" />
                                        <Button Grid.Column="1" Content="Add Item" Click="OnAddDraftSubtaskButtonClicked" FontSize="11" Padding="10,5" />
                                    </Grid>

                                    <!-- Subtasks Interactive List -->
                                    <ScrollViewer MaxHeight="140" VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{x:Bind ViewModel.DraftSubtasks, Mode=OneWay}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="models:PlannerSubTask">
                                                    <Grid Margin="0,3" ColumnSpacing="8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <CheckBox Grid.Column="0" IsChecked="{x:Bind IsCompleted, Mode=TwoWay}" MinWidth="24" Padding="0" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="1" Text="{x:Bind Title}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                        <Button Grid.Column="2" Width="20" Height="20" Padding="0" Background="Transparent" BorderThickness="0" Click="OnRemoveDraftSubtaskClicked" ToolTipService.ToolTip="Remove item">
                                                            <FontIcon Glyph="&#xE711;" FontSize="10" Foreground="{ThemeResource AppTextSecondaryBrush}" />
                                                        </Button>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Grid>
        </ContentDialog>

        <!-- Edit Task Modal Dialog (Rectangular Widescreen) -->
        <ContentDialog
            x:Name="EditTaskModalDialog"
            Title="Edit Task"
            PrimaryButtonText="Save Changes"
            CloseButtonText="Cancel"
            DefaultButton="Primary"
            PrimaryButtonClick="OnEditTaskConfirmed">
            <ContentDialog.Resources>
                <x:Double x:Key="ContentDialogMaxWidth">820</x:Double>
                <x:Double x:Key="ContentDialogMaxHeight">660</x:Double>
            </ContentDialog.Resources>
            <Grid Width="720" RowSpacing="12" Margin="0,6,0,0">
                <Grid.RowDefinitions>
                    <!-- Row 0: Full-width Header: Title & Tags -->
                    <RowDefinition Height="Auto" />
                    <!-- Row 1: Two Columns: Left (Settings) and Right (Description & Checklists) -->
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Full-Width Header: Title & Tag System -->
                <StackPanel Grid.Row="0" Spacing="8">
                    <!-- Title -->
                    <TextBox
                        x:Name="EditTaskTitleBox"
                        Header="Title"
                        PlaceholderText="Task title"
                        Text="{x:Bind ViewModel.EditTaskTitle, Mode=TwoWay}"
                        FontSize="14"
                        FontWeight="SemiBold" />

                    <!-- Tags Header & Quick Presets -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <TextBlock Text="Tags (#):" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource AppTextSecondaryBrush}" VerticalAlignment="Center" />
                            <Button Content="#Work" Padding="8,2" FontSize="11" CornerRadius="10" Click="OnEditQuickTagWorkClicked" Background="{ThemeResource AppCardBackgroundBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}" BorderThickness="1" Foreground="{ThemeResource AppTextPrimaryBrush}" />
                            <Button Content="#Personal" Padding="8,2" FontSize="11" CornerRadius="10" Click="OnEditQuickTagPersonalClicked" Background="{ThemeResource AppCardBackgroundBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}" BorderThickness="1" Foreground="{ThemeResource AppTextPrimaryBrush}" />
                            <Button Content="#Focus" Padding="8,2" FontSize="11" CornerRadius="10" Click="OnEditQuickTagFocusClicked" Background="{ThemeResource AppCardBackgroundBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}" BorderThickness="1" Foreground="{ThemeResource AppTextPrimaryBrush}" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="Right-click chip to change color" FontSize="10" Foreground="{ThemeResource AppTextSecondaryBrush}" VerticalAlignment="Center" />
                    </Grid>

                    <!-- Tag Input & Active Chips Row -->
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Add Tag Input Box -->
                        <Grid Grid.Column="0" ColumnSpacing="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox
                                x:Name="EditTagInputBox"
                                Grid.Column="0"
                                PlaceholderText="Type #tag..."
                                Text="{x:Bind ViewModel.EditTagInputText, Mode=TwoWay}"
                                FontSize="12"
                                KeyDown="OnEditTagInputKeyDown" />
                            <Button Grid.Column="1" Content="Add" Click="OnAddEditTagButtonClicked" FontSize="11" Padding="8,5" />
                        </Grid>

                        <!-- Active Tag Chips Scrollable -->
                        <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{x:Bind ViewModel.EditTaskTags, Mode=OneWay}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="6" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:PlannerTag">
                                        <Grid Margin="0,1,0,2">
                                            <Border Margin="0,1.5,0,-1" CornerRadius="12" Background="{ThemeResource AppTagShadowBrush}" />
                                            <Border
                                                Background="{x:Bind ColorHex, Converter={StaticResource HexToBrushConverter}}"
                                                CornerRadius="12"
                                                Padding="8,3,4,3"
                                                ToolTipService.ToolTip="Right-click to change color">
                                                <Border.ContextFlyout>
                                                    <Flyout>
                                                        <StackPanel Spacing="6">
                                                            <TextBlock Text="Choose Tag Color" FontSize="11" FontWeight="SemiBold" />
                                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                                <Button Width="20" Height="20" CornerRadius="10" Padding="0" Background="#005FB8" Click="OnEditTagChipColorClicked" Tag="#005FB8" ToolTipService.ToolTip="Blue" />
                                                                <Button Width="20" Height="20" CornerRadius="10" Padding="0" Background="#107C41" Click="OnEditTagChipColorClicked" Tag="#107C41" ToolTipService.ToolTip="Emerald" />
                                                                <Button Width="20" Height="20" CornerRadius="10" Padding="0" Background="#744DA9" Click="OnEditTagChipColorClicked" Tag="#744DA9" ToolTipService.ToolTip="Purple" />
                                                                <Button Width="20" Height="20" CornerRadius="10" Padding="0" Background="#CA5010" Click="OnEditTagChipColorClicked" Tag="#CA5010" ToolTipService.ToolTip="Amber" />
                                                                <Button Width="20" Height="20" CornerRadius="10" Padding="0" Background="#D13438" Click="OnEditTagChipColorClicked" Tag="#D13438" ToolTipService.ToolTip="Crimson" />
                                                                <Button Width="20" Height="20" CornerRadius="10" Padding="0" Background="#0078D4" Click="OnEditTagChipColorClicked" Tag="#0078D4" ToolTipService.ToolTip="Cyan" />
                                                                <Button Width="20" Height="20" CornerRadius="10" Padding="0" Background="#038387" Click="OnEditTagChipColorClicked" Tag="#038387" ToolTipService.ToolTip="Teal" />
                                                                <Button Width="20" Height="20" CornerRadius="10" Padding="0" Background="#475569" Click="OnEditTagChipColorClicked" Tag="#475569" ToolTipService.ToolTip="Slate" />
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Flyout>
                                                </Border.ContextFlyout>
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <TextBlock Text="{x:Bind Name}" FontSize="11" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center" />
                                                    <Button Width="18" Height="18" Padding="0" Background="Transparent" BorderThickness="0" Click="OnRemoveEditTagClicked" ToolTipService.ToolTip="Remove tag">
                                                        <FontIcon Glyph="&#xE711;" FontSize="9" Foreground="White" Opacity="0.8" />
                                                    </Button>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </StackPanel>

                <!-- Two-Column Body: Left Settings | Right Description & Checklist -->
                <Grid Grid.Row="1" ColumnSpacing="20">
                    <Grid.ColumnDefinitions>
                        <!-- Left: Settings (290px) -->
                        <ColumnDefinition Width="290" />
                        <!-- Right: Description & Checklists (Flex) -->
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- LEFT COLUMN: Settings -->
                    <StackPanel Grid.Column="0" Spacing="10">
                        <Grid Margin="0,1,0,3">
                            <Border Margin="0,2,0,-1.5" CornerRadius="8" Background="{ThemeResource AppCardShadowBrush}" />
                            <Border Background="{ThemeResource AppCardBackgroundBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="Settings" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource AppTextPrimaryBrush}" />

                                    <!-- Section -->
                                    <ComboBox
                                        Header="Section"
                                        HorizontalAlignment="Stretch"
                                        Text="{x:Bind ViewModel.EditTaskSection, Mode=TwoWay}"
                                        IsEditable="True">
                                        <ComboBoxItem Content="Morning" />
                                        <ComboBoxItem Content="Afternoon" />
                                        <ComboBoxItem Content="Evening" />
                                        <ComboBoxItem Content="Inbox" />
                                        <ComboBoxItem Content="Upcoming" />
                                        <ComboBoxItem Content="Anytime" />
                                        <ComboBoxItem Content="Someday" />
                                    </ComboBox>

                                    <!-- Due Date -->
                                    <CalendarDatePicker
                                        Header="Due Date"
                                        HorizontalAlignment="Stretch"
                                        Date="{x:Bind ViewModel.EditTaskDueDate, Mode=TwoWay}"
                                        PlaceholderText="Pick date" />

                                    <!-- Duration -->
                                    <ComboBox
                                        Header="Duration"
                                        HorizontalAlignment="Stretch"
                                        Text="{x:Bind ViewModel.EditTaskDuration, Mode=TwoWay}"
                                        IsEditable="True"
                                        PlaceholderText="e.g. 15m, 30m">
                                        <ComboBoxItem Content="15m" />
                                        <ComboBoxItem Content="30m" />
                                        <ComboBoxItem Content="45m" />
                                        <ComboBoxItem Content="1h" />
                                        <ComboBoxItem Content="2h" />
                                    </ComboBox>

                                    <!-- Schedule Presets -->
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Schedule Presets" FontSize="11" Foreground="{ThemeResource AppTextSecondaryBrush}" />
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <Button Padding="6,2" FontSize="10" CornerRadius="4" Content="Today" Click="OnEditSchedulePresetTodayClicked" />
                                            <Button Padding="6,2" FontSize="10" CornerRadius="4" Content="Tomorrow" Click="OnEditSchedulePresetTomorrowClicked" />
                                            <Button Padding="6,2" FontSize="10" CornerRadius="4" Content="9:00 AM" Click="OnEditSchedulePresetMorningClicked" />
                                            <Button Padding="6,2" FontSize="10" CornerRadius="4" Content="2:00 PM" Click="OnEditSchedulePresetAfternoonClicked" />
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- List / Project (No "+ New", shows "Non Existent" if empty) -->
                                    <ComboBox
                                        Header="List / Project"
                                        HorizontalAlignment="Stretch"
                                        ItemsSource="{x:Bind ViewModel.Projects, Mode=OneWay}"
                                        DisplayMemberPath="Name"
                                        SelectedValuePath="Id"
                                        SelectedValue="{x:Bind ViewModel.EditTaskProjectId, Mode=TwoWay}"
                                        PlaceholderText="{x:Bind ViewModel.ProjectPlaceholderText, Mode=OneWay}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>

                    <!-- RIGHT COLUMN: Description & Checklist -->
                    <StackPanel Grid.Column="1" Spacing="10">
                        <!-- Description / Notes -->
                        <TextBox
                            Header="Description"
                            PlaceholderText="Extra details or description..."
                            AcceptsReturn="True"
                            Height="90"
                            Text="{x:Bind ViewModel.EditTaskNotes, Mode=TwoWay}"
                            FontSize="12" />

                        <!-- Checklist / Subtasks -->
                        <Grid Margin="0,1,0,3">
                            <Border Margin="0,2,0,-1.5" CornerRadius="8" Background="{ThemeResource AppCardShadowBrush}" />
                            <Border Background="{ThemeResource AppCardBackgroundBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="Checklists &amp; Subtasks" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource AppTextPrimaryBrush}" />

                                    <!-- Add Subtask Input -->
                                    <Grid ColumnSpacing="6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox
                                            x:Name="EditSubtaskInputBox"
                                            Grid.Column="0"
                                            PlaceholderText="Add checklist item and press Enter..."
                                            Text="{x:Bind ViewModel.EditSubtaskInputText, Mode=TwoWay}"
                                            FontSize="12"
                                            KeyDown="OnEditSubtaskInputKeyDown" />
                                        <Button Grid.Column="1" Content="Add Item" Click="OnAddEditSubtaskButtonClicked" FontSize="11" Padding="10,5" />
                                    </Grid>

                                    <!-- Subtasks Interactive List -->
                                    <ScrollViewer MaxHeight="140" VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{x:Bind ViewModel.EditSubtasks, Mode=OneWay}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="models:PlannerSubTask">
                                                    <Grid Margin="0,3" ColumnSpacing="8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <CheckBox Grid.Column="0" IsChecked="{x:Bind IsCompleted, Mode=TwoWay}" MinWidth="24" Padding="0" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="1" Text="{x:Bind Title}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                        <Button Grid.Column="2" Width="20" Height="20" Padding="0" Background="Transparent" BorderThickness="0" Click="OnRemoveEditSubtaskClicked" ToolTipService.ToolTip="Remove item">
                                                            <FontIcon Glyph="&#xE711;" FontSize="10" Foreground="{ThemeResource AppTextSecondaryBrush}" />
                                                        </Button>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Grid>
        </ContentDialog>
    </Grid>
</Page>
