<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="Planner.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Planner"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Planner"
    mc:Ignorable="d">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid Background="{ThemeResource AppCanvasBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="38" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Windows 11 Fluent TitleBar -->
        <Grid
            x:Name="AppTitleBar"
            Grid.Row="0"
            Background="Transparent"
            Padding="12,0,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- App Icon & Title -->
            <StackPanel
                Grid.Column="0"
                Orientation="Horizontal"
                Spacing="8"
                VerticalAlignment="Center">
                <Border
                    Width="18"
                    Height="18"
                    Background="{ThemeResource AppPrimaryAccentBrush}"
                    CornerRadius="4">
                    <FontIcon
                        Glyph="&#xE73E;"
                        FontSize="11"
                        FontWeight="Bold"
                        Foreground="White"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center" />
                </Border>
                <TextBlock
                    Text="Planner — Today"
                    FontSize="12"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource AppTextPrimaryBrush}"
                    VerticalAlignment="Center" />
            </StackPanel>

            <!-- Centered Fluent Search Bar -->
            <Grid
                Grid.Column="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Width="320"
                Height="28">
                <TextBox
                    x:Name="TitleSearchBox"
                    PlaceholderText="Search tasks, lists, or tags (Ctrl+F)"
                    FontSize="12"
                    CornerRadius="4"
                    Padding="28,2,8,2"
                    VerticalAlignment="Center"
                    TextChanged="OnTitleSearchTextChanged" />
                <FontIcon
                    Glyph="&#xE721;"
                    FontSize="12"
                    Foreground="{ThemeResource AppTextSecondaryBrush}"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Margin="8,0,0,0"
                    IsHitTestVisible="False" />
            </Grid>

            <!-- Drag region placeholder on the right before caption buttons -->
            <Border
                x:Name="TitleDragRegion"
                Grid.Column="2"
                Width="140"
                Background="Transparent" />
        </Grid>

        <!-- Main Content Area -->
        <Frame x:Name="RootFrame" Grid.Row="1" />
    </Grid>
</Window>
