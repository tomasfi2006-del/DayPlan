+    /// <summary>
+    /// WinUI allows a single open ContentDialog; a second ShowAsync throws. Skip (returns null) instead of crashing,
+    /// e.g. when a keyboard accelerator tries to open a dialog while another one is showing.
+    /// </summary>
+    private async Task<ContentDialogResult?> ShowDialogAsync(ContentDialog dialog)
+    {
+        if (_dialogOpen) return null;
+        _dialogOpen = true;
+        try
+        {
+            if (dialog.XamlRoot == null && XamlRoot != null)
+            {
+                dialog.XamlRoot = XamlRoot;
+            }
+            return await dialog.ShowAsync();
+        }
+        catch (Exception ex)
+        {
+            System.Diagnostics.Debug.WriteLine($"[MainPage] Dialog failed to open: {ex}");
+            return null;
+        }
+        finally
+        {
+            _dialogOpen = false;
+        }
+    }
+
