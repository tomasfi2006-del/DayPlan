+    /// <summary>
+    /// Restores and focuses the top-level window with the given title, if it exists.
+    /// </summary>
+    public static bool BringExistingWindowToFront(string windowTitle)
+    {
+        nint hWnd = FindWindow(null, windowTitle);
+        if (hWnd == 0)
+        {
+            return false;
+        }
+
+        ShowWindow(hWnd, SW_RESTORE);
+        return SetForegroundWindow(hWnd);
+    }
+
