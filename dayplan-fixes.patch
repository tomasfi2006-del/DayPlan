     private PlannerDataPackage? _currentPackage;
+    private DispatcherTimer? _dayRolloverTimer;
+    private DateTime _lastKnownDay = DateTime.Today;
+
+    private static bool IsTodaySection(string? section) =>
+        section is "Morning" or "Afternoon" or "Evening";
+
+    /// <summary>
+    /// A task belongs to the Today list when it sits in a day section, is not scheduled for a future date,
+    /// and (if completed) was completed today. Older completed tasks live in the Logbook.
+    /// </summary>
+    private static bool IsInTodayList(PlannerTask t)
+    {
+        if (!IsTodaySection(t.Section)) return false;
+        DateTime today = DateTime.Today;
+        if (t.DueDate.HasValue && t.DueDate.Value.Date > today) return false;
+        if (t.IsCompleted && t.CompletedAt.HasValue && t.CompletedAt.Value.Date < today) return false;
+        return true;
+    }
+
+    /// <summary>The single day a task counts towards in the weekly load chart.</summary>
+    private static DateTime? EffectiveDay(PlannerTask t, DateTime today)
+    {
+        if (t.IsCompleted) return (t.CompletedAt ?? t.DueDate)?.Date;
+        if (t.DueDate.HasValue)
+        {
+            DateTime due = t.DueDate.Value.Date;
+            return due < today ? today : due; // overdue work lands on today
+        }
+        return IsTodaySection(t.Section) ? today : null;
+    }
+
+    private static int TimeSortKey(string? text) =>
+        DateTime.TryParse(text, out var parsed) ? (int)parsed.TimeOfDay.TotalMinutes : int.MaxValue;
+
+    private void StartDayRolloverTimer()
+    {
+        if (_dayRolloverTimer != null) return;
+        _dayRolloverTimer = new DispatcherTimer { Interval = TimeSpan.FromMinutes(1) };
+        _dayRolloverTimer.Tick += async (_, _) =>
+        {
+            if (DateTime.Today == _lastKnownDay) return;
+            _lastKnownDay = DateTime.Today;
+            CurrentDateText = DateTime.Now.ToString("dddd, MMMM d");
+            try { await LoadDataAsync(); }
+            catch (Exception ex) { System.Diagnostics.Debug.WriteLine(ex); }
+        };
+        _dayRolloverTimer.Start();
+    }
+
+    private static async void RunSafe(Func<Task> action)
+    {
+        try { await action(); }
+        catch (Exception ex) { System.Diagnostics.Debug.WriteLine($"[MainViewModel] Background operation failed: {ex}"); }
+    }
 
